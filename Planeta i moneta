<script>
  function showSection(id) {
    document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    const map = { menu: 0, install: 1, howto: 2, authors: 3 };
    document.querySelectorAll('.nav-btn')[map[id]].classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function loadPhoto(input, wrapId) {
    if (!input.files || !input.files[0]) return;
    const reader = new FileReader();
    reader.onload = e => {
      document.getElementById(wrapId).innerHTML = '<img src="' + e.target.result + '" alt="Фото автора">';
    };
    reader.readAsDataURL(input.files[0]);
  }

  const canvas = document.getElementById('stars-canvas');
  const ctx = canvas.getContext('2d');
  let stars = [];

  const starColors = [
    {r:155,g:176,b:255},{r:170,g:191,b:255},{r:202,g:215,b:255},
    {r:255,g:255,b:255},{r:255,g:255,b:238},{r:255,g:244,b:214},
    {r:255,g:229,b:180},{r:255,g:204,b:153},{r:255,g:180,b:130},
  ];

  function resizeCanvas() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    initStars();
  }
  window.addEventListener('resize', resizeCanvas);

  function initStars() {
    stars = [];
    const count = Math.floor((canvas.width * canvas.height) / 1800);
    for (let i = 0; i < count; i++) {
      const col = starColors[Math.floor(Math.random() * starColors.length)];
      const size = Math.random();
      const r = size < 0.7 ? Math.random() * 0.6 + 0.1
               : size < 0.9 ? Math.random() * 0.8 + 0.5
               : Math.random() * 1.2 + 1.0;
      stars.push({ x: Math.random() * canvas.width, y: Math.random() * canvas.height, r, col,
        baseAlpha: Math.random() * 0.5 + 0.4, alpha: Math.random(),
        twinkleSpeed: Math.random() * 0.008 + 0.002, twinklePhase: Math.random() * Math.PI * 2, glow: r > 1.0 });
    }
    for (let i = 0; i < 12; i++) {
      const col = starColors[Math.floor(Math.random() * 3)];
      stars.push({ x: Math.random() * canvas.width, y: Math.random() * canvas.height,
        r: Math.random() * 1.5 + 1.8, col, baseAlpha: 0.85, alpha: 0.85,
        twinkleSpeed: Math.random() * 0.005 + 0.002, twinklePhase: Math.random() * Math.PI * 2, glow: true });
    }
  }
  resizeCanvas();

  function drawStars() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    stars.forEach(s => {
      s.twinklePhase += s.twinkleSpeed;
      s.alpha = Math.max(0.05, Math.min(1, s.baseAlpha + Math.sin(s.twinklePhase) * 0.25));
      const {r, g, b} = s.col;
      if (s.glow && s.r > 1.0) {
        const grad = ctx.createRadialGradient(s.x, s.y, 0, s.x, s.y, s.r * 5);
        grad.addColorStop(0, `rgba(${r},${g},${b},${s.alpha * 0.6})`);
        grad.addColorStop(0.4, `rgba(${r},${g},${b},${s.alpha * 0.15})`);
        grad.addColorStop(1, `rgba(${r},${g},${b},0)`);
        ctx.beginPath(); ctx.arc(s.x, s.y, s.r * 5, 0, Math.PI * 2);
        ctx.fillStyle = grad; ctx.fill();
        if (s.r > 2.0) {
          ctx.save(); ctx.globalAlpha = s.alpha * 0.3;
          ctx.strokeStyle = `rgb(${r},${g},${b})`; ctx.lineWidth = 0.5;
          const sp = s.r * 8;
          ctx.beginPath();
          ctx.moveTo(s.x - sp, s.y); ctx.lineTo(s.x + sp, s.y);
          ctx.moveTo(s.x, s.y - sp); ctx.lineTo(s.x, s.y + sp);
          ctx.stroke(); ctx.restore();
        }
      }
      ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${r},${g},${b},${s.alpha})`; ctx.fill();
    });
    requestAnimationFrame(drawStars);
  }
  drawStars();

  function createShootingStar() {
    const el = document.createElement('div');
    el.className = 'shooting-star';
    el.style.left = Math.random() * window.innerWidth + 'px';
    el.style.top = Math.random() * window.innerHeight * 0.5 + 'px';
    el.style.animationDuration = (Math.random() * 0.8 + 0.4) + 's';
    el.style.width = (Math.random() * 60 + 30) + 'px';
    el.style.background = 'linear-gradient(to right, white, transparent)';
    el.style.transform = 'rotate(' + (Math.random() * 30 + 20) + 'deg)';
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 1200);
  }
  setInterval(createShootingStar, 2500);
  setTimeout(createShootingStar, 800);
</script>
