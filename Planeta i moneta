<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Планета и Монета</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Rajdhani:wght@300;400;500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;} 

:root{
  --space: #010208;
  --navy: #030818;
  --cyan: #00e5ff;
  --cyan2: #00b4d8;
  --gold: #ffd60a;
  --gold2: #ffaa00;
  --purple: #7b2fff;
  --pink: #ff006e;
  --text: #cce8ff;
  --dim: #3a5a7a;
  --card: rgba(3,8,24,0.85);
}

html{scroll-behavior:smooth;}

body{
  background:var(--space);
  color:var(--text);
  font-family:'Rajdhani',sans-serif;
  min-height:100vh;
  overflow-x:hidden;
  cursor:none;
}

#cursor{
  position:fixed;
  width:12px;height:12px;
  background:var(--cyan);
  border-radius:50%;
  pointer-events:none;
  z-index:9999;
  transform:translate(-50%,-50%);
  transition:transform 0.1s, width 0.2s, height 0.2s, opacity 0.2s;
  box-shadow:0 0 12px var(--cyan), 0 0 24px rgba(0,229,255,0.5);
  mix-blend-mode:screen;
}
#cursor-ring{
  position:fixed;
  width:36px;height:36px;
  border:1.5px solid rgba(0,229,255,0.5);
  border-radius:50%;
  pointer-events:none;
  z-index:9998;
  transform:translate(-50%,-50%);
  transition:transform 0.18s ease, width 0.25s, height 0.25s;
}
body:hover #cursor{opacity:1;}

#space-canvas{
  position:fixed;
  inset:0;
  width:100%;height:100%;
  z-index:0;
  pointer-events:none;
}

.nebula{
  position:fixed;
  border-radius:50%;
  filter:blur(80px);
  pointer-events:none;
  z-index:0;
}
.nebula-1{width:700px;height:500px;top:-200px;left:-200px;background:radial-gradient(ellipse,rgba(123,47,255,0.18) 0%,transparent 70%);}
.nebula-2{width:600px;height:600px;bottom:-200px;right:-100px;background:radial-gradient(ellipse,rgba(0,180,216,0.15) 0%,transparent 70%);}
.nebula-3{width:400px;height:400px;top:40%;left:60%;background:radial-gradient(ellipse,rgba(255,0,110,0.08) 0%,transparent 70%);}

#sun-wrap{
  position:fixed;
  bottom:-160px;right:-120px;
  width:500px;height:500px;
  z-index:1;
  pointer-events:none;
}
.sun-outer{
  position:absolute;
  inset:0;border-radius:50%;
  background:radial-gradient(circle at center, transparent 22%, rgba(255,100,0,0.06) 40%, rgba(255,60,0,0.03) 60%, transparent 75%);
  animation:sun-corona-spin 20s linear infinite;
}
.sun-mid{
  position:absolute;
  inset:60px;border-radius:50%;
  background:radial-gradient(circle at center, transparent 30%, rgba(255,150,0,0.12) 50%, transparent 65%);
  animation:sun-corona-spin 12s linear infinite reverse;
}
.sun-body{
  position:absolute;
  inset:120px;border-radius:50%;
  background:radial-gradient(circle at 38% 32%, #fff9d0, #ffe033, #ff9500, #ff3d00);
  box-shadow:
    0 0 0 8px rgba(255,200,0,0.15),
    0 0 40px 10px rgba(255,160,0,0.8),
    0 0 100px 30px rgba(255,100,0,0.5),
    0 0 200px 60px rgba(255,60,0,0.3),
    0 0 350px 100px rgba(200,30,0,0.15);
  animation:sun-breathe 5s ease-in-out infinite;
}
.sun-ray{
  position:absolute;
  top:50%;left:50%;
  height:1.5px;
  transform-origin:0 50%;
  background:linear-gradient(to right, rgba(255,200,0,0.7), transparent);
  border-radius:2px;
}
@keyframes sun-corona-spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
@keyframes sun-breathe{
  0%,100%{box-shadow:0 0 0 8px rgba(255,200,0,0.15),0 0 40px 10px rgba(255,160,0,0.8),0 0 100px 30px rgba(255,100,0,0.5),0 0 200px 60px rgba(255,60,0,0.3),0 0 350px 100px rgba(200,30,0,0.15);}
  50%{box-shadow:0 0 0 12px rgba(255,220,0,0.2),0 0 60px 16px rgba(255,180,0,0.9),0 0 130px 40px rgba(255,120,0,0.6),0 0 260px 80px rgba(255,80,0,0.35),0 0 400px 120px rgba(200,40,0,0.2);}
}

#earth-wrap{
  position:fixed;
  top:40px;left:-80px;
  width:280px;height:280px;
  z-index:1;
  pointer-events:none;
  animation:float-slow 11s ease-in-out infinite;
}
.earth-atmo{
  position:absolute;
  inset:-16px;border-radius:50%;
  background:radial-gradient(circle at center, transparent 44%, rgba(60,140,255,0.14) 52%, rgba(60,140,255,0.06) 62%, transparent 70%);
}
.earth-body{
  position:absolute;
  inset:0;border-radius:50%;
  background:
    radial-gradient(circle at 28% 28%, rgba(255,255,255,0.2) 0%, transparent 35%),
    radial-gradient(ellipse at 55% 68%, #1d7a45 0%, #1d7a45 20%, transparent 20%),
    radial-gradient(ellipse at 32% 52%, #1d7a45 0%, #1d7a45 24%, transparent 24%),
    radial-gradient(ellipse at 72% 32%, #1d7a45 0%, #1d7a45 16%, transparent 16%),
    radial-gradient(ellipse at 48% 18%, #c9a84c 0%, #c9a84c 11%, transparent 11%),
    radial-gradient(circle at 50% 50%, #1870b8, #0d4a8a, #061e35);
  box-shadow:0 0 50px rgba(30,130,255,0.3),0 0 100px rgba(30,130,255,0.12),inset -30px -30px 60px rgba(0,0,40,0.7);
}
.earth-clouds{
  position:absolute;
  inset:-3px;border-radius:50%;
  background:
    radial-gradient(ellipse at 38% 22%, rgba(255,255,255,0.25) 0%, rgba(255,255,255,0.25) 18%, transparent 18%),
    radial-gradient(ellipse at 68% 58%, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0.18) 13%, transparent 13%),
    radial-gradient(ellipse at 18% 62%, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0.16) 11%, transparent 11%),
    radial-gradient(ellipse at 80% 80%, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.12) 9%, transparent 9%);
  animation:clouds-spin 35s linear infinite;
}
@keyframes float-slow{0%,100%{transform:translateY(0) rotate(-3deg);}50%{transform:translateY(-18px) rotate(3deg);}}
@keyframes clouds-spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}

#moon-wrap{
  position:fixed;
  bottom:0;
  left:calc(50% - 200px);
  width:400px;
  height:240px;
  z-index:2;
  pointer-events:none;
}
.moon-glow-ring{
  position:absolute;
  bottom:55px;left:0;right:0;height:80px;
  background:radial-gradient(ellipse at 50% 100%, rgba(210,195,150,0.22) 0%, transparent 70%);
}
.moon-hill{
  position:absolute;
  bottom:0;left:0;right:0;height:130px;
  border-radius:55% 55% 0 0 / 50% 50% 0 0;
  overflow:hidden;
}
.moon-hill-inner{
  position:absolute;
  inset:0;
  background:linear-gradient(180deg, #c8bb94 0%, #a89d70 35%, #7a7050 100%);
  box-shadow:inset 0 12px 40px rgba(0,0,0,0.5), inset 0 -4px 20px rgba(255,240,180,0.1);
}
.moon-crater{
  position:absolute;
  border-radius:50%;
  background:radial-gradient(circle at 40% 38%, rgba(255,255,255,0.08), rgba(0,0,0,0.35));
  border:1px solid rgba(0,0,0,0.18);
}
.moon-horizon-glow{
  position:absolute;
  bottom:125px;left:0;right:0;height:20px;
  background:linear-gradient(to top, rgba(200,185,130,0.25), transparent);
}

.astronaut-group{
  position:absolute;
  bottom:120px;
  left:50%;
  transform:translateX(-50%);
  animation:astro-breathe 3.5s ease-in-out infinite;
}
.flag-pole{
  position:absolute;
  bottom:0;right:-48px;
  width:2px;height:52px;
  background:linear-gradient(to bottom, #d0d0e0, #8090a0);
  border-radius:1px;
}
.flag{
  position:absolute;
  top:0;left:2px;
  width:28px;height:16px;
  background:linear-gradient(135deg, var(--cyan), var(--purple));
  border-radius:1px 2px 2px 1px;
  animation:flag-wave 2s ease-in-out infinite;
  transform-origin:left center;
}
.flag::after{
  content:'★';
  position:absolute;
  top:50%;left:50%;
  transform:translate(-50%,-50%);
  font-size:8px;
  color:rgba(255,255,255,0.8);
}

.rocket-group{
  position:absolute;
  bottom:120px;
  left:calc(50% + 52px);
  animation:rocket-hover 3s ease-in-out infinite;
  transform:rotate(8deg);
}
.rocket-flame-wrap{
  position:absolute;
  bottom:-16px;left:50%;
  transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:2px;
}
.rflame{border-radius:0 0 50% 50%;animation:flame-anim 0.12s ease-in-out infinite alternate;}
.rflame-1{width:12px;height:18px;background:radial-gradient(ellipse at 50% 0%, #fff 0%, #ffcc00 40%, #ff6600 80%, transparent 100%);}
.rflame-2{width:8px;height:12px;background:radial-gradient(ellipse at 50% 0%, #ffdd88 0%, #ff8800 60%, transparent 100%);opacity:0.7;}

@keyframes astro-breathe{0%,100%{transform:translateX(-50%) translateY(0);}50%{transform:translateX(-50%) translateY(-5px);}}
@keyframes rocket-hover{0%,100%{transform:rotate(8deg) translateY(0);}50%{transform:rotate(8deg) translateY(-8px);}}
@keyframes flag-wave{0%,100%{transform:skewY(0deg) scaleX(1);}50%{transform:skewY(-4deg) scaleX(0.92);}}
@keyframes flame-anim{from{transform:scaleY(1);}to{transform:scaleY(1.35) scaleX(0.85);}}

.shooting-star{
  position:fixed;height:2px;
  background:linear-gradient(to right, rgba(255,255,255,0.9), transparent);
  border-radius:2px;
  pointer-events:none;z-index:1;
  animation:shoot linear forwards;
}
@keyframes shoot{to{transform:translate(400px,400px);opacity:0;}}

nav{
  position:fixed;
  top:0;left:0;right:0;
  z-index:500;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 40px;
  height:64px;
  background:rgba(1,2,8,0.6);
  backdrop-filter:blur(20px) saturate(180%);
  border-bottom:1px solid rgba(0,229,255,0.1);
}
.nav-logo{
  font-family:'Orbitron',monospace;
  font-size:0.85rem;
  font-weight:900;
  background:linear-gradient(90deg, var(--cyan), var(--gold));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  letter-spacing:0.12em;
  white-space:nowrap;
}
.nav-links{display:flex;gap:6px;align-items:center;}
.nav-btn{
  font-family:'Orbitron',monospace;
  font-size:0.58rem;
  font-weight:700;
  letter-spacing:0.14em;
  text-transform:uppercase;
  padding:8px 18px;
  background:transparent;
  border:1px solid rgba(0,229,255,0.18);
  color:var(--dim);
  cursor:pointer;
  border-radius:3px;
  transition:all 0.25s;
  position:relative;overflow:hidden;
  white-space:nowrap;
}
.nav-btn::after{
  content:'';
  position:absolute;bottom:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg, var(--cyan), var(--gold));
  transform:scaleX(0);
  transition:transform 0.25s;
}
.nav-btn:hover::after,.nav-btn.active::after{transform:scaleX(1);}
.nav-btn:hover,.nav-btn.active{color:#fff;border-color:rgba(0,229,255,0.4);background:rgba(0,229,255,0.05);}

header{
  position:relative;z-index:10;
  min-height:100vh;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  padding:80px 20px 240px;
  text-align:center;
}
.header-badge{
  font-family:'Share Tech Mono',monospace;
  font-size:0.7rem;
  color:var(--cyan);
  letter-spacing:0.35em;
  text-transform:uppercase;
  margin-bottom:28px;
  opacity:0.7;
  animation:badge-in 1s ease 0.2s both;
}
.header-badge span{color:var(--gold);}

.logo-icons{
  display:flex;align-items:center;justify-content:center;
  gap:28px;margin-bottom:24px;
  animation:icons-in 1s ease 0.4s both;
}
.planet-orb{
  width:80px;height:80px;border-radius:50%;flex-shrink:0;
  background:radial-gradient(circle at 38% 34%, #88ddff, #0088cc, #002244);
  box-shadow:0 0 0 2px rgba(0,180,255,0.3), 0 0 30px rgba(0,180,255,0.6), 0 0 70px rgba(0,100,255,0.3);
  position:relative;
  animation:planet-breathe 6s ease-in-out infinite;
}
.planet-orb::before{
  content:'';position:absolute;inset:0;border-radius:50%;
  background:radial-gradient(ellipse at 38% 38%, rgba(255,255,255,0.12) 0%, transparent 60%);
}
.planet-orb::after{
  content:'';position:absolute;
  top:50%;left:-26px;width:calc(100% + 52px);height:24px;
  border:2px solid rgba(0,200,255,0.45);border-radius:50%;
  transform:translateY(-50%) rotateX(72deg);
}
.coin-orb{
  width:70px;height:70px;border-radius:50%;flex-shrink:0;
  background:radial-gradient(circle at 36% 30%, #fff8b0, #ffcc00, #ff8800, #6b3800);
  box-shadow:0 0 0 2px rgba(255,200,0,0.3), 0 0 30px rgba(255,180,0,0.6), 0 0 70px rgba(255,100,0,0.3);
  display:flex;align-items:center;justify-content:center;
  font-family:'Orbitron',monospace;font-size:26px;color:#6b3800;font-weight:900;
  animation:coin-spin 5s ease-in-out infinite;
}
@keyframes planet-breathe{0%,100%{box-shadow:0 0 0 2px rgba(0,180,255,0.3),0 0 30px rgba(0,180,255,0.6),0 0 70px rgba(0,100,255,0.3);}50%{box-shadow:0 0 0 4px rgba(0,200,255,0.4),0 0 50px rgba(0,200,255,0.8),0 0 100px rgba(0,150,255,0.4);}}
@keyframes coin-spin{0%,100%{transform:scaleX(1);box-shadow:0 0 0 2px rgba(255,200,0,0.3),0 0 30px rgba(255,180,0,0.6),0 0 70px rgba(255,100,0,0.3);}50%{transform:scaleX(0.1);box-shadow:0 0 5px rgba(255,180,0,0.3);}}
@keyframes icons-in{from{opacity:0;transform:translateY(-20px);}to{opacity:1;transform:translateY(0);}}
@keyframes badge-in{from{opacity:0;letter-spacing:0.6em;}to{opacity:0.7;letter-spacing:0.35em;}}

h1{
  font-family:'Orbitron',monospace;
  font-size:clamp(2.4rem, 6vw, 5.5rem);
  font-weight:900;
  line-height:1.05;
  letter-spacing:0.04em;
  margin-bottom:20px;
  position:relative;
  animation:title-in 1s ease 0.6s both;
}
.h1-line1{
  display:block;
  background:linear-gradient(135deg, #fff 20%, var(--cyan) 50%, #fff 80%);
  background-size:200% auto;
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  animation:title-in 1s ease 0.6s both, shimmer 4s linear infinite;
  filter:drop-shadow(0 0 30px rgba(0,229,255,0.4));
}
.h1-line2{
  display:block;
  background:linear-gradient(135deg, var(--gold) 20%, #fff 50%, var(--gold2) 80%);
  background-size:200% auto;
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  animation:title-in 1s ease 0.8s both, shimmer 4s linear 0.5s infinite;
  filter:drop-shadow(0 0 30px rgba(255,200,0,0.4));
}
@keyframes shimmer{from{background-position:0% center;}to{background-position:200% center;}}
@keyframes title-in{from{opacity:0;transform:translateY(30px);}to{opacity:1;transform:translateY(0);}}

.subtitle{
  font-family:'Share Tech Mono',monospace;
  font-size:0.8rem;
  color:rgba(0,229,255,0.5);
  letter-spacing:0.28em;
  text-transform:uppercase;
  margin-bottom:48px;
  animation:badge-in 1s ease 1s both;
}

.hero-btns{
  display:flex;gap:16px;flex-wrap:wrap;justify-content:center;
  animation:btns-in 1s ease 1.2s both;
}
@keyframes btns-in{from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:translateY(0);}}

.btn-primary{
  font-family:'Orbitron',monospace;
  font-size:0.72rem;
  font-weight:700;
  letter-spacing:0.14em;
  text-transform:uppercase;
  padding:16px 36px;
  background:linear-gradient(135deg, var(--cyan), var(--cyan2));
  color:#000;
  border:none;border-radius:4px;
  cursor:pointer;text-decoration:none;
  transition:all 0.3s;
  box-shadow:0 0 0 0 rgba(0,229,255,0.4), 0 4px 30px rgba(0,229,255,0.3);
  position:relative;overflow:hidden;
}
.btn-primary::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg, rgba(255,255,255,0.2), transparent);
  opacity:0;transition:opacity 0.3s;
}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 0 30px rgba(0,229,255,0.5),0 8px 40px rgba(0,229,255,0.3);}
.btn-primary:hover::before{opacity:1;}

.btn-outline{
  font-family:'Orbitron',monospace;
  font-size:0.72rem;
  font-weight:700;
  letter-spacing:0.14em;
  text-transform:uppercase;
  padding:15px 32px;
  background:transparent;
  color:var(--text);
  border:1px solid rgba(0,229,255,0.35);
  border-radius:4px;
  cursor:pointer;text-decoration:none;
  transition:all 0.3s;
}
.btn-outline:hover{background:rgba(0,229,255,0.06);border-color:var(--cyan);color:#fff;transform:translateY(-3px);box-shadow:0 0 20px rgba(0,229,255,0.2);}

.scroll-hint{
  position:absolute;
  bottom:200px;left:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:8px;
  font-family:'Share Tech Mono',monospace;font-size:0.6rem;
  color:rgba(0,229,255,0.35);letter-spacing:0.2em;
  animation:scroll-hint-fade 2s ease 2s both;
}
.scroll-mouse{
  width:20px;height:32px;
  border:1.5px solid rgba(0,229,255,0.3);
  border-radius:10px;position:relative;
}
.scroll-mouse::after{
  content:'';position:absolute;
  top:5px;left:50%;transform:translateX(-50%);
  width:2px;height:6px;
  background:var(--cyan);border-radius:2px;
  animation:scroll-dot 1.8s ease-in-out infinite;
}
@keyframes scroll-dot{0%{opacity:1;transform:translateX(-50%) translateY(0);}100%{opacity:0;transform:translateX(-50%) translateY(10px);}}
@keyframes scroll-hint-fade{from{opacity:0;}to{opacity:1;}}

main{position:relative;z-index:10;}

.section{
  display:none;
  padding:100px 24px 80px;
  max-width:1000px;
  margin:0 auto;
  animation:sec-in 0.5s ease;
}
.section.active{display:block;}
@keyframes sec-in{from{opacity:0;transform:translateY(24px);}to{opacity:1;transform:translateY(0);}}

.sec-label{
  font-family:'Share Tech Mono',monospace;
  font-size:0.65rem;
  color:var(--cyan);opacity:0.6;
  letter-spacing:0.3em;text-transform:uppercase;
  margin-bottom:8px;
}
.sec-title{
  font-family:'Orbitron',monospace;
  font-size:clamp(1.4rem, 3vw, 2.2rem);
  font-weight:900;
  color:#fff;
  margin-bottom:50px;
  display:flex;align-items:center;gap:16px;
  letter-spacing:0.06em;
}
.sec-title-line{
  flex:1;height:1px;
  background:linear-gradient(to right, rgba(0,229,255,0.4), transparent);
}

.cards-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
  gap:20px;
  margin-bottom:60px;
}
.gcard{
  background:var(--card);
  border:1px solid rgba(0,229,255,0.1);
  border-radius:8px;
  padding:28px 24px;
  position:relative;overflow:hidden;
  transition:all 0.35s;
  backdrop-filter:blur(10px);
}
.gcard::before{
  content:'';position:absolute;
  top:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg, var(--cyan), var(--gold), var(--purple));
  transform:scaleX(0);transform-origin:left;
  transition:transform 0.4s;
}
.gcard::after{
  content:'';position:absolute;
  inset:0;
  background:radial-gradient(ellipse at 50% 0%, rgba(0,229,255,0.05) 0%, transparent 60%);
  opacity:0;transition:opacity 0.3s;
}
.gcard:hover{transform:translateY(-6px);border-color:rgba(0,229,255,0.3);box-shadow:0 10px 50px rgba(0,229,255,0.1),0 0 0 1px rgba(0,229,255,0.08);}
.gcard:hover::before{transform:scaleX(1);}
.gcard:hover::after{opacity:1;}
.gcard-icon{font-size:2.2rem;margin-bottom:16px;display:block;}
.gcard h3{
  font-family:'Orbitron',monospace;font-size:0.78rem;
  color:var(--cyan);margin-bottom:10px;letter-spacing:0.08em;
}
.gcard p{font-size:0.9rem;color:var(--dim);line-height:1.7;font-weight:400;}

.hero-box{
  background:var(--card);
  border:1px solid rgba(0,229,255,0.12);
  border-radius:12px;
  padding:56px 48px;
  text-align:center;
  margin-bottom:48px;
  position:relative;overflow:hidden;
  backdrop-filter:blur(16px);
}
.hero-box::before{
  content:'';position:absolute;top:0;left:0;right:0;height:1px;
