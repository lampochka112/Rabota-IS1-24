<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Планета и Монета</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Exo+2:wght@300;400;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #02030f;
    --deep: #060920;
    --accent: #00d4ff;
    --accent2: #ffd700;
    --glow: rgba(0,212,255,0.4);
    --glow2: rgba(255,215,0,0.4);
    --text: #c8e8f8;
    --dim: #5a7a9a;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Exo 2', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }

  #stars-canvas {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  body::before {
    content: '';
    position: fixed;
    top: -30%; left: -20%;
    width: 80vw; height: 80vh;
    background: radial-gradient(ellipse, rgba(0,50,120,0.25) 0%, transparent 70%);
    z-index: 0;
    pointer-events: none;
  }
  body::after {
    content: '';
    position: fixed;
    bottom: -20%; right: -10%;
    width: 60vw; height: 60vh;
    background: radial-gradient(ellipse, rgba(80,0,140,0.2) 0%, transparent 70%);
    z-index: 0;
    pointer-events: none;
  }

  #sun {
    position: fixed;
    bottom: -120px;
    right: -80px;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
  }
  .sun-core {
    position: absolute;
    inset: 60px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #fff8c0, #ffdd00, #ff8c00, #ff4500);
    box-shadow:
      0 0 60px 20px rgba(255,160,0,0.8),
      0 0 120px 50px rgba(255,100,0,0.5),
      0 0 200px 80px rgba(255,60,0,0.3);
    animation: sun-pulse 4s ease-in-out infinite;
  }
  .sun-corona {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at center, transparent 30%, rgba(255,120,0,0.15) 60%, transparent 75%);
    animation: corona-rotate 12s linear infinite;
  }
  .sun-ray {
    position: absolute;
    top: 50%; left: 50%;
    width: 200px; height: 2px;
    transform-origin: 0 50%;
    background: linear-gradient(to right, rgba(255,200,0,0.6), transparent);
    border-radius: 2px;
  }
  .sun-flare {
    position: absolute;
    inset: 20px;
    border-radius: 50%;
    background: radial-gradient(circle at center, transparent 50%, rgba(255,180,0,0.08) 70%, transparent 80%);
    animation: flare-pulse 6s ease-in-out infinite alternate;
  }
  @keyframes sun-pulse {
    0%,100% { box-shadow: 0 0 60px 20px rgba(255,160,0,0.8), 0 0 120px 50px rgba(255,100,0,0.5), 0 0 200px 80px rgba(255,60,0,0.3); }
    50%      { box-shadow: 0 0 80px 30px rgba(255,180,0,0.9), 0 0 160px 70px rgba(255,120,0,0.6), 0 0 260px 100px rgba(255,80,0,0.35); }
  }
  @keyframes corona-rotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes flare-pulse {
    from { opacity: 0.5; transform: scale(1); }
    to   { opacity: 1; transform: scale(1.1); }
  }

  #earth {
    position: fixed;
    top: 60px;
    left: -60px;
    width: 220px;
    height: 220px;
    z-index: 0;
    pointer-events: none;
    animation: earth-float 9s ease-in-out infinite;
  }
  .earth-sphere {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 30%, rgba(255,255,255,0.18) 0%, transparent 40%),
      radial-gradient(ellipse at 60% 70%, #1a6b3c 0%, #1a6b3c 18%, transparent 18%),
      radial-gradient(ellipse at 35% 55%, #1a6b3c 0%, #1a6b3c 22%, transparent 22%),
      radial-gradient(ellipse at 75% 35%, #1a6b3c 0%, #1a6b3c 14%, transparent 14%),
      radial-gradient(ellipse at 50% 20%, #c8a84b 0%, #c8a84b 10%, transparent 10%),
      radial-gradient(circle at 50% 50%, #1464a0, #0d3d6b, #061e35);
    box-shadow:
      0 0 40px rgba(30,120,255,0.35),
      0 0 80px rgba(30,120,255,0.15),
      inset -20px -20px 40px rgba(0,0,30,0.6);
  }
  .earth-clouds {
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 40% 25%, rgba(255,255,255,0.22) 0%, rgba(255,255,255,0.22) 16%, transparent 16%),
      radial-gradient(ellipse at 70% 60%, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0.16) 12%, transparent 12%),
      radial-gradient(ellipse at 20% 65%, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0.14) 10%, transparent 10%);
    animation: clouds-drift 30s linear infinite;
  }
  .earth-atmosphere {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    background: radial-gradient(circle at center, transparent 46%, rgba(80,160,255,0.12) 55%, rgba(80,160,255,0.06) 65%, transparent 72%);
  }
  @keyframes earth-float {
    0%,100% { transform: translateY(0px) rotate(-2deg); }
    50%      { transform: translateY(-14px) rotate(2deg); }
  }
  @keyframes clouds-drift { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

  #moon-scene {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 340px;
    height: 200px;
    z-index: 1;
    pointer-events: none;
  }
  .moon-surface {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 100px;
    background: radial-gradient(ellipse at 50% 100%, #d4c9a8 0%, #b0a47e 40%, #8a7d58 100%);
    border-radius: 50% 50% 0 0 / 40% 40% 0 0;
    box-shadow: 0 -10px 40px rgba(200,185,130,0.25), inset 0 10px 30px rgba(0,0,0,0.4);
  }
  .moon-crater {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, rgba(255,255,255,0.1), rgba(0,0,0,0.3));
    border: 1px solid rgba(0,0,0,0.2);
  }
  .moon-glow {
    position: absolute;
    bottom: 60px; left: 0; right: 0;
    height: 60px;
    background: radial-gradient(ellipse at 50% 100%, rgba(200,185,130,0.18) 0%, transparent 70%);
  }

  .astronaut {
    position: absolute;
    bottom: 88px;
    left: 50%;
    transform: translateX(-50%);
    animation: astronaut-breathe 3s ease-in-out infinite;
  }
  .astronaut svg {
    width: 52px;
    height: 72px;
    filter: drop-shadow(0 0 8px rgba(200,230,255,0.5));
  }
  .rocket {
    position: absolute;
    bottom: 92px;
    left: calc(50% + 36px);
    animation: rocket-idle 2.5s ease-in-out infinite;
  }
  .rocket svg {
    width: 28px;
    height: 50px;
    filter: drop-shadow(0 0 6px rgba(255,150,50,0.6));
  }
  .rocket-flame {
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 10px;
    height: 14px;
    background: radial-gradient(ellipse at 50% 0%, #fff 0%, #ffb300 40%, #ff4400 70%, transparent 100%);
    border-radius: 0 0 50% 50%;
    animation: flame-flicker 0.15s ease-in-out infinite alternate;
  }
  @keyframes astronaut-breathe {
    0%,100% { transform: translateX(-50%) translateY(0); }
    50%      { transform: translateX(-50%) translateY(-4px); }
  }
  @keyframes rocket-idle {
    0%,100% { transform: translateY(0) rotate(3deg); }
    50%      { transform: translateY(-6px) rotate(3deg); }
  }
  @keyframes flame-flicker {
    from { opacity: 0.8; transform: translateX(-50%) scaleY(1); }
    to   { opacity: 1; transform: translateX(-50%) scaleY(1.3) scaleX(0.85); }
  }

  .shooting-star {
    position: fixed;
    top: 0; left: 0;
    background: white;
    border-radius: 2px;
    filter: blur(0.5px);
    pointer-events: none;
    z-index: 1;
    animation: shoot linear forwards;
    height: 2px;
  }
  @keyframes shoot { to { transform: translate(300px, 300px); opacity: 0; } }

  header {
    position: relative;
    z-index: 10;
    padding: 60px 20px 30px;
    text-align: center;
  }
  .logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 10px;
  }
  .planet-icon {
    width: 64px; height: 64px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #4af, #06c, #003);
    box-shadow: 0 0 30px rgba(0,180,255,0.7), inset 0 0 20px rgba(0,0,80,0.5);
    animation: planet-glow 8s linear infinite;
    position: relative;
    flex-shrink: 0;
  }
  .planet-icon::after {
    content: '';
    position: absolute;
    top: 50%; left: -20px;
    width: calc(100% + 40px);
    height: 20px;
    border: 2px solid rgba(0,210,255,0.5);
    border-radius: 50%;
    transform: translateY(-50%) rotateX(70deg);
  }
  .coin-icon {
    width: 56px; height: 56px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ffe88a, #ffa500, #7a4800);
    box-shadow: 0 0 30px rgba(255,200,0,0.7);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Orbitron', monospace;
    font-size: 22px;
    color: #7a4800;
    font-weight: 900;
    animation: coin-spin 4s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes planet-glow {
    from { box-shadow: 0 0 30px rgba(0,180,255,0.7), inset 0 0 20px rgba(0,0,80,0.5); }
    50%  { box-shadow: 0 0 50px rgba(0,220,255,0.9), inset 0 0 20px rgba(0,0,80,0.5); }
    to   { box-shadow: 0 0 30px rgba(0,180,255,0.7), inset 0 0 20px rgba(0,0,80,0.5); }
  }
  @keyframes coin-spin {
    0%,100% { transform: scaleX(1); box-shadow: 0 0 30px rgba(255,200,0,0.7); }
    50%      { transform: scaleX(0.15); box-shadow: 0 0 10px rgba(255,200,0,0.3); }
  }
  h1 {
    font-family: 'Orbitron', monospace;
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 900;
    background: linear-gradient(135deg, var(--accent), #fff, var(--accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 0.08em;
    animation: title-glow 3s ease-in-out infinite alternate;
  }
  @keyframes title-glow {
    from { filter: drop-shadow(0 0 8px rgba(0,212,255,0.5)); }
    to   { filter: drop-shadow(0 0 20px rgba(255,215,0,0.6)); }
  }
  .subtitle {
    font-size: 0.95rem;
    color: var(--dim);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-top: 8px;
  }

  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    gap: 4px;
    padding: 12px 20px;
    background: rgba(2,3,15,0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0,212,255,0.15);
  }
  .nav-btn {
    font-family: 'Orbitron', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 10px 20px;
    background: transparent;
    border: 1px solid rgba(0,212,255,0.25);
    color: var(--dim);
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
  }
  .nav-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0,212,255,0.1), rgba(255,215,0,0.05));
    opacity: 0;
    transition: opacity 0.3s;
  }
  .nav-btn:hover::before, .nav-btn.active::before { opacity: 1; }
  .nav-btn:hover, .nav-btn.active {
    color: #fff;
    border-color: var(--accent);
    box-shadow: 0 0 20px var(--glow);
  }

  main { position: relative; z-index: 5; }
  .section {
    display: none;
    padding: 60px 20px;
    max-width: 900px;
    margin: 0 auto;
    animation: fadeIn 0.5s ease;
  }
  .section.active { display: block; }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .section-title {
    font-family: 'Orbitron', monospace;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 40px;
    display: flex;
    align-items: center;
    gap: 14px;
    letter-spacing: 0.08em;
  }
  .section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, rgba(0,212,255,0.5), transparent);
  }

  .menu-hero {
    background: radial-gradient(ellipse at center, rgba(0,50,120,0.3) 0%, transparent 70%);
    border: 1px solid rgba(0,212,255,0.15);
    border-radius: 16px;
    padding: 50px 40px;
    text-align: center;
    margin-bottom: 40px;
    position: relative;
    overflow: hidden;
  }
  .menu-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--accent), transparent);
  }
  .menu-hero p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text);
    max-width: 600px;
    margin: 0 auto 30px;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .feature-card {
    background: rgba(6,9,32,0.8);
    border: 1px solid rgba(0,212,255,0.12);
    border-radius: 12px;
    padding: 28px 24px;
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
  }
  .feature-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(to right, var(--accent), var(--accent2));
    transform: scaleX(0);
    transition: transform 0.3s;
    transform-origin: left;
  }
  .feature-card:hover::before { transform: scaleX(1); }
  .feature-card:hover {
    border-color: rgba(0,212,255,0.35);
    box-shadow: 0 8px 40px rgba(0,212,255,0.1);
    transform: translateY(-4px);
  }
  .feature-icon { font-size: 2rem; margin-bottom: 14px; }
  .feature-card h3 {
    font-family: 'Orbitron', monospace;
    font-size: 0.85rem;
    color: var(--accent);
    margin-bottom: 8px;
    letter-spacing: 0.08em;
  }
  .feature-card p { font-size: 0.9rem; color: var(--dim); line-height: 1.6; }

  .download-box {
    background: rgba(6,9,32,0.9);
    border: 1px solid rgba(0,212,255,0.2);
    border-radius: 16px;
    padding: 40px;
    margin-bottom: 30px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .download-box::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(0,212,255,0.06), transparent 60%);
  }
  .game-icon-large {
    width: 100px; height: 100px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #4af, #06c, #003);
    margin: 0 auto 24px;
    box-shadow: 0 0 60px rgba(0,180,255,0.5);
    animation: pulse-glow 3s ease-in-out infinite;
    position: relative;
    z-index: 1;
  }
  @keyframes pulse-glow {
    0%,100% { box-shadow: 0 0 40px rgba(0,180,255,0.5); }
    50%      { box-shadow: 0 0 80px rgba(0,180,255,0.8), 0 0 120px rgba(0,180,255,0.3); }
  }
  .download-box h3 {
    font-family: 'Orbitron', monospace;
    font-size: 1.3rem;
    color: #fff;
    margin-bottom: 8px;
    position: relative; z-index: 1;
  }
  .download-box p { color: var(--dim); margin-bottom: 28px; position: relative; z-index: 1; }
  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Orbitron', monospace;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 14px 32px;
    background: linear-gradient(135deg, var(--accent), #0088cc);
    color: #000;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s;
    position: relative; z-index: 1;
    box-shadow: 0 4px 30px rgba(0,212,255,0.4);
  }
  .btn-download:hover {
    box-shadow: 0 6px 50px rgba(0,212,255,0.7);
    transform: translateY(-2px);
    filter: brightness(1.1);
  }

  .install-steps { display: flex; flex-direction: column; gap: 16px; }
  .step {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    background: rgba(6,9,32,0.6);
    border: 1px solid rgba(0,212,255,0.1);
    border-radius: 10px;
    padding: 20px 24px;
    transition: all 0.3s;
  }
  .step:hover { border-color: rgba(0,212,255,0.3); }
  .step-num {
    font-family: 'Orbitron', monospace;
    font-size: 1.4rem;
    font-weight: 900;
    color: var(--accent);
    min-width: 36px;
    opacity: 0.7;
  }
  .step-content h4 {
    font-family: 'Orbitron', monospace;
    font-size: 0.8rem;
    color: #fff;
    margin-bottom: 6px;
    letter-spacing: 0.05em;
  }
  .step-content p { font-size: 0.88rem; color: var(--dim); line-height: 1.6; }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
  }
  .guide-card {
    background: rgba(6,9,32,0.8);
    border: 1px solid rgba(255,215,0,0.12);
    border-radius: 12px;
    padding: 28px;
    transition: all 0.3s;
  }
  .guide-card:hover {
    border-color: rgba(255,215,0,0.35);
    box-shadow: 0 8px 40px rgba(255,215,0,0.08);
    transform: translateY(-4px);
  }
  .guide-icon { font-size: 2.4rem; margin-bottom: 14px; }
  .guide-card h3 {
    font-family: 'Orbitron', monospace;
    font-size: 0.82rem;
    color: var(--accent2);
    margin-bottom: 10px;
    letter-spacing: 0.06em;
  }
  .guide-card p { font-size: 0.88rem; color: var(--dim); line-height: 1.7; }

  .controls-table {
    width: 100%;
    border-collapse: collapse;
    background: rgba(6,9,32,0.8);
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(0,212,255,0.12);
  }
  .controls-table th {
    background: rgba(0,212,255,0.08);
    font-family: 'Orbitron', monospace;
    font-size: 0.72rem;
    color: var(--accent);
    padding: 14px 20px;
    text-align: left;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .controls-table td {
    padding: 12px 20px;
    font-size: 0.88rem;
    color: var(--dim);
    border-top: 1px solid rgba(0,212,255,0.06);
  }
  .controls-table tr:hover td { background: rgba(0,212,255,0.04); color: var(--text); }
  .key {
    display: inline-block;
    background: rgba(0,212,255,0.12);
    border: 1px solid rgba(0,212,255,0.3);
    border-radius: 4px;
    padding: 2px 10px;
    font-family: 'Orbitron', monospace;
    font-size: 0.7rem;
    color: var(--accent);
  }

  .authors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }
  .author-card {
    background: rgba(6,9,32,0.9);
    border-radius: 16px;
    padding: 40px 32px;
    text-align: center;
    position: relative;
    overflow: hidden;
    transition: all 0.4s;
  }
  .author-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
    padding: 1px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }
  .author-card:hover { transform: translateY(-6px); box-shadow: 0 20px 60px rgba(0,212,255,0.15); }

  .author-photo-wrap {
    position: relative;
    width: 110px;
    height: 110px;
    margin: 0 auto 22px;
  }
  .author-photo-wrap::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent2), var(--accent));
    animation: photo-border-spin 4s linear infinite;
    z-index: 0;
  }
  .author-card.site-dev .author-photo-wrap::before {
    background: linear-gradient(135deg, var(--accent2), var(--accent), var(--accent2));
  }
  @keyframes photo-border-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

  .author-photo {
    position: relative;
    z-index: 1;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    overflow: hidden;
    background: rgba(6,9,32,0.9);
    border: 3px solid rgba(2,3,15,0.9);
  }
  .author-photo img {
    width: 100%;
