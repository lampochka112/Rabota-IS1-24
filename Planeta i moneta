<script>
const cur = document.getElementById('cursor');
const ring = document.getElementById('cursor-ring');
let mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove', e=>{
  mx=e.clientX; my=e.clientY;
  cur.style.left=mx+'px'; cur.style.top=my+'px';
});
(function animRing(){
  rx+=(mx-rx)*0.14; ry+=(my-ry)*0.14;
  ring.style.left=rx+'px'; ring.style.top=ry+'px';
  requestAnimationFrame(animRing);
})();
document.querySelectorAll('a,button,.gcard,.hcard,.acard,.step-item,.author-photo').forEach(el=>{
  el.addEventListener('mouseenter',()=>{cur.style.width='20px';cur.style.height='20px';ring.style.width='52px';ring.style.height='52px';});
  el.addEventListener('mouseleave',()=>{cur.style.width='12px';cur.style.height='12px';ring.style.width='36px';ring.style.height='36px';});
});

function showSection(id){
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  const map={menu:0,install:1,howto:2,authors:3};
  document.querySelectorAll('.nav-btn')[map[id]].classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
}

function setPhoto(input,wrapId){
  if(!input.files||!input.files[0])return;
  const r=new FileReader();
  r.onload=e=>{
    const w=document.getElementById(wrapId);
    w.innerHTML='<img src="'+e.target.result+'" alt="Фото">';
  };
  r.readAsDataURL(input.files[0]);
}

const cvs=document.getElementById('space-canvas');
const ctx=cvs.getContext('2d');
let stars=[];
const SC=[
  {r:155,g:176,b:255},{r:170,g:191,b:255},{r:202,g:215,b:255},
  {r:255,g:255,b:255},{r:255,g:255,b:238},{r:255,g:244,b:214},
  {r:255,g:229,b:180},{r:255,g:204,b:153},{r:255,g:180,b:130},
];
function resize(){
  cvs.width=innerWidth; cvs.height=innerHeight;
  stars=[];
  const n=Math.floor(innerWidth*innerHeight/1400);
  for(let i=0;i<n;i++){
    const c=SC[Math.floor(Math.random()*SC.length)];
    const s=Math.random();
    const rad=s<0.72?Math.random()*0.55+0.08:s<0.9?Math.random()*0.75+0.45:Math.random()*1.1+0.9;
    stars.push({x:Math.random()*cvs.width,y:Math.random()*cvs.height,r:rad,c,
      ba:Math.random()*0.45+0.4,a:Math.random(),
      ts:Math.random()*0.007+0.002,ph:Math.random()*Math.PI*2,gl:rad>0.9});
  }
  for(let i=0;i<14;i++){
    const c=SC[Math.floor(Math.random()*3)];
    stars.push({x:Math.random()*cvs.width,y:Math.random()*cvs.height,
      r:Math.random()*1.6+1.8,c,ba:0.9,a:0.9,
      ts:Math.random()*0.004+0.002,ph:Math.random()*Math.PI*2,gl:true});
  }
}
window.addEventListener('resize',resize);
resize();

function draw(){
  ctx.clearRect(0,0,cvs.width,cvs.height);
  stars.forEach(s=>{
    s.ph+=s.ts;
    s.a=Math.max(0.04,Math.min(1,s.ba+Math.sin(s.ph)*0.28));
    const{r,g,b}=s.c;
    if(s.gl&&s.r>0.9){
      const gd=ctx.createRadialGradient(s.x,s.y,0,s.x,s.y,s.r*5.5);
      gd.addColorStop(0,`rgba(${r},${g},${b},${s.a*0.65})`);
      gd.addColorStop(0.4,`rgba(${r},${g},${b},${s.a*0.14})`);
      gd.addColorStop(1,`rgba(${r},${g},${b},0)`);
      ctx.beginPath();ctx.arc(s.x,s.y,s.r*5.5,0,Math.PI*2);
      ctx.fillStyle=gd;ctx.fill();
      if(s.r>2.2){
        ctx.save();ctx.globalAlpha=s.a*0.28;
        ctx.strokeStyle=`rgb(${r},${g},${b})`;ctx.lineWidth=0.5;
        const sp=s.r*9;
        ctx.beginPath();
        ctx.moveTo(s.x-sp,s.y);ctx.lineTo(s.x+sp,s.y);
        ctx.moveTo(s.x,s.y-sp);ctx.lineTo(s.x,s.y+sp);
        ctx.stroke();ctx.restore();
      }
    }
    ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
    ctx.fillStyle=`rgba(${r},${g},${b},${s.a})`;ctx.fill();
  });
  requestAnimationFrame(draw);
}
draw();

function shootStar(){
  const el=document.createElement('div');
  el.className='shooting-star';
  el.style.left=Math.random()*innerWidth+'px';
  el.style.top=Math.random()*innerHeight*0.55+'px';
  el.style.animationDuration=(Math.random()*0.7+0.3)+'s';
  el.style.width=(Math.random()*80+40)+'px';
  el.style.transform='rotate('+(Math.random()*35+15)+'deg)';
  el.style.opacity=Math.random()*0.6+0.4;
  document.body.appendChild(el);
  setTimeout(()=>el.remove(),1100);
}
setInterval(shootStar,2200);
setTimeout(shootStar,600);
setTimeout(shootStar,1400);
</script>
