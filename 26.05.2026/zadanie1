<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
  <meta name="description" content="Туристический маршрут по улицам Элисты, названным в честь героев Великой Отечественной Войны. Агентство «Калмыкия Тур».">
  <title>Герои ВОВ | Калмыкия Тур — Маршрут Памяти в Элисте</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&family=Cormorant+Garamond:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg-dark: #0a0c12;
      --bg-surface: #12151e;
      --bg-card: #1a1e2a;
      --bg-elevated: #232838;
      --accent-gold: #d4af37;
      --accent-gold-glow: rgba(212, 175, 55, 0.3);
      --accent-red: #8b2c2c;
      --accent-red-dark: #5c1a1a;
      --text-primary: #f0ebe1;
      --text-secondary: #c9c3b5;
      --text-muted: #8a8478;
      --border-glass: rgba(212, 175, 55, 0.2);
      --shadow-xl: 0 25px 45px -12px rgba(0, 0, 0, 0.6);
      --shadow-gold: 0 0 30px rgba(212, 175, 55, 0.2);
      --nav-height: 85px;
      --transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      --radius-xl: 24px;
      --radius-lg: 16px;
    }

    .light-theme {
      --bg-dark: #f5f2eb;
      --bg-surface: #ffffff;
      --bg-card: #ffffff;
      --bg-elevated: #f0ede7;
      --text-primary: #1e1b16;
      --text-secondary: #4a453e;
      --text-muted: #958f86;
      --border-glass: rgba(139, 44, 44, 0.15);
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg-dark);
      color: var(--text-primary);
      line-height: 1.5;
      transition: var(--transition);
      overflow-x: hidden;
    }

    /* Military Themed Background */
    .hero-background {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -2;
      background: radial-gradient(circle at 20% 30%, rgba(30, 20, 15, 0.9), rgba(5, 5, 10, 0.95)), url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI4MCIgaGVpZ2h0PSI4MCIgdmlld0JveD0iMCAwIDQwIDQwIj48cGF0aCBmaWxsPSIjZDVhZjM1IiBmaWxsLW9wYWNpdHk9IjAuMDQiIGQ9Ik0yMCAyTDIgMTBsMTggOCAxOC04LTE4LTh6TTIgMjBsMTggOCAxOC04TTIgMzBsMTggOCAxOC04Ii8+PC9zdmc+');
      background-repeat: repeat;
      background-size: 40px;
    }
    .light-theme .hero-background {
      background: radial-gradient(circle at 20% 30%, rgba(240, 235, 225, 0.8), rgba(255, 255, 245, 0.95)), url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI4MCIgaGVpZ2h0PSI4MCIgdmlld0JveD0iMCAwIDQwIDQwIj48cGF0aCBmaWxsPSIjOGIyYzJjIiBmaWxsLW9wYWNpdHk9IjAuMDQiIGQ9Ik0yMCAyTDIgMTBsMTggOCAxOC04LTE4LTh6TTIgMjBsMTggOCAxOC04TTIgMzBsMTggOCAxOC04Ii8+PC9zdmc+');
    }

    /* Military Ribbon Decoration */
    .military-ribbon {
      position: fixed;
      top: 100px;
      right: -40px;
      transform: rotate(45deg);
      background: linear-gradient(135deg, #000, #8b2c2c, #d4af37, #8b2c2c);
      width: 200px;
      height: 40px;
      z-index: 99;
      opacity: 0.7;
      pointer-events: none;
    }

    .glass {
      background: rgba(26, 30, 42, 0.55);
      backdrop-filter: blur(12px);
      border: 1px solid var(--border-glass);
    }

    .container {
      max-width: 1300px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    section {
      padding: 100px 0;
      position: relative;
      z-index: 2;
    }

    h1, h2, h3, .serif {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
    h1 { font-size: clamp(3rem, 5.5vw, 5rem); line-height: 1.1; margin-bottom: 1.5rem; }
    h2 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1rem; }
    .section-title { text-align: center; margin-bottom: 3.5rem; }
    .section-title h2 { display: inline-block; position: relative; }
    .section-title h2:after {
      content: '';
      position: absolute;
      bottom: -12px;
      left: 50%;
      transform: translateX(-50%);
      width: 70px;
      height: 3px;
      background: linear-gradient(90deg, var(--accent-red), var(--accent-gold));
      border-radius: 3px;
    }
    .section-subtitle { color: var(--text-secondary); max-width: 700px; margin: 1rem auto 0; }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 12px 32px;
      border-radius: 50px;
      font-weight: 600;
      transition: var(--transition);
      border: none;
      cursor: pointer;
    }
    .btn-primary { background: linear-gradient(135deg, #8b2c2c, #4a1818); color: white; box-shadow: 0 8px 20px rgba(139, 44, 44, 0.3); }
    .btn-primary:hover { transform: translateY(-3px); gap: 14px; background: linear-gradient(135deg, #a33a3a, #6b2222); }
    .btn-gold { background: var(--accent-gold); color: #0a0c12; font-weight: 800; }
    .btn-gold:hover { transform: translateY(-3px); box-shadow: 0 0 20px var(--accent-gold-glow); }
    .btn-outline { background: transparent; border: 1.5px solid var(--accent-gold); color: var(--accent-gold); }
    .btn-outline:hover { background: var(--accent-gold); color: #0a0c12; }

    /* Navbar */
    .navbar {
      position: fixed;
      width: 100%;
      height: var(--nav-height);
      background: rgba(10, 12, 18, 0.85);
      backdrop-filter: blur(15px);
      border-bottom: 1px solid var(--border-glass);
      z-index: 1000;
    }
    .nav-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 100%;
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
    }
    .nav-logo { display: flex; align-items: center; gap: 12px; font-size: 1.5rem; font-weight: 800; }
    .nav-logo span { color: var(--accent-gold); }
    .nav-links { display: flex; gap: 2rem; align-items: center; }
    .nav-links a { color: var(--text-secondary); transition: 0.2s; font-weight: 500; }
    .nav-links a:hover { color: var(--accent-gold); }
    .theme-toggle { background: var(--bg-elevated); border: none; width: 42px; height: 42px; border-radius: 50%; cursor: pointer; }
    .hamburger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; }
    .hamburger span { width: 28px; height: 2px; background: var(--text-primary); }

    /* Hero Section */
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding-top: var(--nav-height);
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
    .hero-badge {
      background: rgba(212, 175, 55, 0.15);
      border: 1px solid rgba(212, 175, 55, 0.4);
      border-radius: 40px;
      padding: 6px 20px;
      display: inline-block;
      margin-bottom: 1.5rem;
    }
    .hero-stats { display: flex; gap: 2rem; margin-top: 2.5rem; flex-wrap: wrap; }
    .stat-number { font-size: 2rem; font-weight: 800; color: var(--accent-gold); font-family: 'Cormorant Garamond', serif; }

    /* Slider */
    .hero-slider {
      position: relative;
      border-radius: 28px;
      overflow: hidden;
      box-shadow: var(--shadow-xl);
      height: 480px;
    }
    .slider-track { display: flex; transition: transform 0.6s ease; height: 100%; }
    .slide { min-width: 100%; position: relative; }
    .slide-bg {
      width: 100%;
      height: 100%;
      background: linear-gradient(145deg, #232838, #12151e);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 6rem;
    }
    .slide-info {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(to top, #000000cc, transparent);
      padding: 2rem;
    }
    .slider-btn {
      position: absolute;
      bottom: 20px;
      right: 20px;
      width: 44px;
      height: 44px;
      background: var(--accent-gold);
      border: none;
      border-radius: 50%;
      font-size: 1.4rem;
      cursor: pointer;
    }

    /* Cards Grid */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2rem;
    }
    .card {
      background: var(--bg-card);
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1px solid var(--border-glass);
      transition: all 0.3s ease;
    }
    .card:hover { transform: translateY(-8px); border-color: var(--accent-gold); box-shadow: var(--shadow-gold); }
    .card-img {
      height: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3.5rem;
      background: radial-gradient(circle at 30% 20%, var(--bg-elevated), var(--bg-dark));
    }

    /* Image placeholder style */
    .image-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #2a3a4a, #1a2530);
      color: var(--accent-gold);
      font-size: 0.9rem;
      text-align: center;
      padding: 1rem;
    }
    .image-placeholder i { font-size: 2.5rem; margin-bottom: 0.5rem; }
    .image-placeholder small { font-size: 0.7rem; opacity: 0.7; }

    /* Timeline War Style */
    .timeline {
      max-width: 900px;
      margin: 0 auto;
      position: relative;
    }
    .timeline:before {
      content: '';
      position: absolute;
      left: 120px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--accent-gold);
      opacity: 0.4;
    }
    .timeline-item {
      display: flex;
      gap: 2rem;
      margin-bottom: 2.5rem;
      opacity: 0;
      transform: translateX(-20px);
      transition: all 0.6s;
    }
    .timeline-item.visible { opacity: 1; transform: translateX(0); }
    .timeline-year {
      min-width: 100px;
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--accent-gold);
    }
    .timeline-content {
      background: var(--bg-card);
      padding: 1.5rem;
      border-radius: var(--radius-lg);
      border-left: 4px solid var(--accent-gold);
    }

    /* Interactive Map Preview */
    .map-preview {
      background: var(--bg-card);
      border-radius: var(--radius-xl);
      padding: 1rem;
      border: 1px solid var(--border-glass);
      text-align: center;
    }
    .interactive-point {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(212, 175, 55, 0.15);
      border-radius: 50px;
      padding: 8px 18px;
      margin: 6px;
      transition: 0.2s;
      cursor: pointer;
    }
    .interactive-point:hover { background: var(--accent-gold); color: #0a0c12; }

    /* Testimonials */
    .testimonials-scroll {
      display: flex;
      gap: 2rem;
      overflow-x: auto;
      padding: 1rem 0.2rem;
    }
    .testimonial-card {
      min-width: 360px;
      background: var(--bg-card);
      border-radius: var(--radius-lg);
      padding: 2rem;
      border: 1px solid var(--border-glass);
    }

    /* Forms */
    .form-modern {
      background: var(--bg-card);
      border-radius: 32px;
      padding: 2rem;
      border: 1px solid var(--border-glass);
    }
    .form-group { margin-bottom: 1.2rem; }
    .form-group input, .form-group select {
      width: 100%;
      padding: 12px 20px;
      background: var(--bg-surface);
      border: 1px solid var(--border-glass);
      border-radius: 60px;
      color: var(--text-primary);
    }
    .alert { display: none; padding: 12px; border-radius: 60px; margin-bottom: 1rem; }
    .alert.show { display: block; }

    /* Footer */
    .footer {
      background: var(--bg-surface);
      border-top: 1px solid var(--border-glass);
      padding: 3rem 0 2rem;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 2rem;
    }

    @media (max-width: 1024px) {
      .hero-grid { grid-template-columns: 1fr; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
      .nav-links { display: none; position: fixed; top: var(--nav-height); left: 0; right: 0; background: var(--bg-dark); flex-direction: column; padding: 2rem; gap: 1rem; backdrop-filter: blur(20px); }
      .nav-links.open { display: flex; }
      .hamburger { display: flex; }
    }
    @media (max-width: 768px) {
      .timeline:before { left: 20px; }
      .timeline-item { flex-direction: column; gap: 0.5rem; }
      .testimonial-card { min-width: 280px; }
    }
    .fade-up {
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.7s ease;
    }
    .fade-up.visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
</head>
<body>
  <div class="hero-background"></div>
  <div class="military-ribbon"></div>

  <nav class="navbar">
    <div class="nav-container">
      <div class="nav-logo"><svg width="36" height="36" viewBox="0 0 38 38"><circle cx="19" cy="19" r="18" stroke="#d4af37" stroke-width="1.5"/><polygon points="19,4 22.5,14.5 33.5,14.5 24.5,21 28,31.5 19,25 10,31.5 13.5,21 4.5,14.5 15.5,14.5" fill="#d4af37"/></svg> Герои <span>ВОВ</span></div>
