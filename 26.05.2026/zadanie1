  <script>
    let slideIndex = 0;
    const trackSlide = document.getElementById('sliderTrack');
    const slidesCount = trackSlide.children.length;
    document.getElementById('nextBtn').onclick = () => { slideIndex = (slideIndex + 1) % slidesCount; trackSlide.style.transform = `translateX(-${slideIndex * 100}%)`; };
    document.getElementById('prevBtn').onclick = () => { slideIndex = (slideIndex - 1 + slidesCount) % slidesCount; trackSlide.style.transform = `translateX(-${slideIndex * 100}%)`; };
    setInterval(() => { slideIndex = (slideIndex + 1) % slidesCount; trackSlide.style.transform = `translateX(-${slideIndex * 100}%)`; }, 5000);

    function bookTourFinal() {
      const name = document.getElementById('fullName').value;
      const alertDiv = document.getElementById('bookingAlert');
      if (!name) { alertDiv.className = 'alert alert-error show'; alertDiv.innerHTML = '⚠ Пожалуйста, введите ваше имя'; setTimeout(() => alertDiv.classList.remove('show'), 2500); return; }
      alertDiv.className = 'alert alert-success show'; alertDiv.innerHTML = '✅ Заявка принята! Скоро с вами свяжется менеджер. Спасибо за интерес к истории.';
      setTimeout(() => alertDiv.classList.remove('show'), 3000);
    }
    function toggleTheme() { document.body.classList.toggle('light-theme'); }
    const observer = new IntersectionObserver((entries) => { entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }); }, { threshold: 0.1 });
    document.querySelectorAll('.fade-up, .timeline-item').forEach(el => observer.observe(el));
  </script>
