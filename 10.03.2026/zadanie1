                ]
            }
        ];

        // Инициализация при загрузке страницы
        document.addEventListener('DOMContentLoaded', function() {
            const citiesContainer = document.getElementById('cities-container');
            const cityModal = document.getElementById('cityModal');
            const closeModal = document.getElementById('closeModal');
            
            // Добавление городов в список
            citiesData.forEach(city => {
                const cityLink = document.createElement('a');
                cityLink.className = 'city-item';
                cityLink.href = city.website;
                cityLink.target = '_blank';
                cityLink.setAttribute('data-city-id', city.id);
                
                // Добавляем содержимое ссылки
                cityLink.innerHTML = `
                    <div class="city-link">
                        <div>
                            <div class="city-name">${city.name}</div>
                            <div class="city-population">Население: ${city.population} тыс. чел.</div>
                            <div class="external-link">
                                Открыть сайт <i class="fas fa-external-link-alt"></i>
                            </div>
                        </div>
                        <img src="${city.photos[0]}" alt="${city.name}" class="city-photo">
                    </div>
                `;
                
                citiesContainer.appendChild(cityLink);
                
                // Добавляем обработчик для открытия модального окна по правому клику или Ctrl+клик
                cityLink.addEventListener('click', function(e) {
                    // Если зажат Ctrl или нажата средняя кнопка мыши - разрешаем переход
                    if (e.ctrlKey || e.metaKey || e.button === 1) {
                        return;
                    }
                    
                    // Если клик левой кнопкой без Ctrl - открываем модальное окно
                    if (e.button === 0) {
                        e.preventDefault();
                        openCityModal(city);
                    }
                });
                
                // Добавляем контекстное меню для выбора действия
                cityLink.addEventListener('contextmenu', function(e) {
                    e.preventDefault();
                    openCityModal(city);
                });
            });
            
            // Закрытие модального окна
            closeModal.addEventListener('click', function() {
                cityModal.style.display = 'none';
            });
            
            // Закрытие модального окна при клике вне его
            window.addEventListener('click', function(e) {
                if (e.target === cityModal) {
                    cityModal.style.display = 'none';
                }
            });
        });
        
        // Функция открытия модального окна с информацией о городе
        function openCityModal(city) {
            const cityModal = document.getElementById('cityModal');
            const cityHeader = document.getElementById('cityHeader');
            const photoGallery = document.getElementById('photoGallery');
            const officialWebsite = document.getElementById('officialWebsite');
            
            // Заполняем данные о городе
            document.getElementById('modalCityName').textContent = city.name;
            document.getElementById('modalCityRegion').textContent = city.region;
            document.getElementById('modalPopulation').textContent = city.population + ' тыс.';
            document.getElementById('modalFoundation').textContent = city.foundation;
            document.getElementById('modalArea').textContent = city.area;
            document.getElementById('modalTimezone').textContent = city.timezone;
            document.getElementById('modalDescription').textContent = city.description;
            
            // Устанавливаем ссылку на официальный сайт
            officialWebsite.href = city.website;
            officialWebsite.innerHTML = `<i class="fas fa-external-link-alt"></i> Посетить официальный сайт ${city.name}`;
            
            // Устанавливаем фон заголовка
            cityHeader.style.backgroundImage = `url('${city.photos[0]}')`;
            
            // Очищаем и заполняем фотогалерею
            photoGallery.innerHTML = '';
            city.photos.forEach(photo => {
                const photoItem = document.createElement('div');
                photoItem.className = 'photo-item';
                
                const photoLink = document.createElement('a');
                photoLink.href = photo;
                photoLink.target = '_blank';
                
                const photoImg = document.createElement('img');
                photoImg.src = photo;
                photoImg.alt = city.name;
                
                photoLink.appendChild(photoImg);
                photoItem.appendChild(photoLink);
                photoGallery.appendChild(photoItem);
            });
            
            // Показываем модальное окно
            cityModal.style.display = 'flex';
        }
    </script>
</body>
</html>
