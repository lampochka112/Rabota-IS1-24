    <script>
        const clickMeBtn = document.getElementById('clickMeBtn');
        const clickCountElement = document.getElementById('clickCount');
        const clickCounterElement = document.getElementById('clickCounter');
        const timeSpentElement = document.getElementById('timeSpent');
        const colorChangesElement = document.getElementById('colorChanges');
        const achievementsElement = document.getElementById('achievements');
        const scrollTopBtn = document.getElementById('scrollTop');
        const themeToggleBtn = document.getElementById('themeToggle');
        const projectsContainer = document.getElementById('projectsContainer');
        const tabButtons = document.querySelectorAll('.tab-btn');
        const skillCards = document.querySelectorAll('.skill-card');
        const colorButtons = document.querySelectorAll('.color-btn');
        const typedTextElement = document.getElementById('typedText');
        const cursorElement = document.getElementById('cursor');
        const particlesContainer = document.getElementById('particles');
        
        let clickCount = 0;
        let timeSpent = 0;
        let colorChanges = 0;
        let achievements = [];
        let startTime = Date.now();
        let isLightTheme = false;
        
        const texts = [
            "Создание цифровых миров с помощью кода - это искусство, которым я живу",
            "Каждая строчка кода - это шаг к созданию чего-то удивительного",
            "Программирование - это не работа, а образ мышления и стиль жизни",
            "Превращаю сложные задачи в элегантные решения с помощью кода"
        ];
        
        let currentTextIndex = 0;
        let currentCharIndex = 0;
        let isDeleting = false;
        let isTypingPaused = false;
        
        function typeWriter() {
            if (isTypingPaused) return;
            
            const currentText = texts[currentTextIndex];
            
            if (!isDeleting && currentCharIndex < currentText.length) {
                typedTextElement.textContent += currentText.charAt(currentCharIndex);
                currentCharIndex++;
                setTimeout(typeWriter, 50);
            } else if (isDeleting && currentCharIndex > 0) {
                typedTextElement.textContent = currentText.substring(0, currentCharIndex - 1);
                currentCharIndex--;
                setTimeout(typeWriter, 30);
            } else if (!isDeleting && currentCharIndex === currentText.length) {
                isTypingPaused = true;
                setTimeout(() => {
                    isTypingPaused = false;
                    isDeleting = true;
                    setTimeout(typeWriter, 1500);
                }, 2000);
            } else if (isDeleting && currentCharIndex === 0) {
                isDeleting = false;
                currentTextIndex = (currentTextIndex + 1) % texts.length;
                setTimeout(typeWriter, 500);
            }
        }
        
        function createParticles() {
            const particleCount = 50;
            
            for (let i = 0; i < particleCount; i++) {
                const particle = document.createElement('div');
                particle.classList.add('particle');
                
                const size = Math.random() * 4 + 1;
                const posX = Math.random() * 100;
                const posY = Math.random() * 100;
                const delay = Math.random() * 5;
                const duration = Math.random() * 10 + 10;
                
                particle.style.width = `${size}px`;
                particle.style.height = `${size}px`;
                particle.style.left = `${posX}%`;
                particle.style.top = `${posY}%`;
                particle.style.animationDelay = `${delay}s`;
                particle.style.animationDuration = `${duration}s`;
                particle.style.opacity = Math.random() * 0.5 + 0.1;
                
                particlesContainer.appendChild(particle);
            }
        }
        
        function updateTimeSpent() {
            const now = Date.now();
            timeSpent = Math.floor((now - startTime) / 1000);
            timeSpentElement.textContent = timeSpent;
        }
        
        function addAchievement(text) {
            if (!achievements.includes(text)) {
                achievements.push(text);
                const achievement = document.createElement('div');
                achievement.classList.add('achievement');
                achievement.innerHTML = `<i class="fas fa-trophy"></i> ${text}`;
                achievementsElement.appendChild(achievement);
                
                setTimeout(() => {
                    achievement.style.opacity = '0';
                    achievement.style.transform = 'scale(0.8)';
                    setTimeout(() => {
                        if (achievementsElement.contains(achievement)) {
                            achievementsElement.removeChild(achievement);
                        }
                    }, 500);
                }, 3000);
            }
        }
        
        function handleClick() {
            clickCount++;
            clickCountElement.textContent = clickCount;
            
            const colors = ['#64ffda', '#00a8ff', '#c678dd', '#e6c07b', '#e06c75', '#50fa7b'];
            const randomColor = colors[Math.floor(Math.random() * colors.length)];
            const nextColor = colors[(colors.indexOf(randomColor) + 1) % colors.length];
            
            clickMeBtn.style.background = `linear-gradient(90deg, ${randomColor}, ${nextColor})`;
            
            clickMeBtn.style.transform = 'translateY(-8px) scale(1.05)';
            setTimeout(() => {
                clickMeBtn.style.transform = 'translateY(-8px) scale(1.05)';
            }, 150);
            
            if (clickCount % 10 === 0) {
                addAchievement(`Достижение: ${clickCount} нажатий!`);
            }
            
            if (clickCount === 25) addAchievement('Серебряный уровень!');
            if (clickCount === 50) addAchievement('Золотой уровень!');
            if (clickCount === 100) addAchievement('Платиновый уровень!');
        }
        
        function handleColorChange(color) {
            colorChanges++;
            colorChangesElement.textContent = colorChanges;
            
            document.documentElement.style.setProperty('--primary-color', color);
            
            const hueRotate = Math.floor(Math.random() * 360);
            document.querySelector('.shape-1').style.filter = `hue-rotate(${hueRotate}deg) blur(40px)`;
            
            if (colorChanges % 5 === 0) {
                addAchievement(`Сменил ${colorChanges} цветов!`);
            }
        }
        
        function handleTabClick(event) {
            const filter = event.target.getAttribute('data-filter');
            
            tabButtons.forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            
            projectsContainer.style.opacity = '0';
            projectsContainer.style.transform = 'translateY(30px)';
            
            setTimeout(() => {
                const projectCards = document.querySelectorAll('.project-card');
                
                projectCards.forEach(card => {
                    if (filter === 'all' || card.getAttribute('data-category') === filter) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
                
                projectsContainer.style.opacity = '1';
                projectsContainer.style.transform = 'translateY(0)';
            }, 300);
        }
        
        function toggleTheme() {
            isLightTheme = !isLightTheme;
            
            if (isLightTheme) {
                document.documentElement.style.setProperty('--dark-bg', '#f0f4f8');
                document.documentElement.style.setProperty('--card-bg', '#ffffff');
                document.documentElement.style.setProperty('--card-bg-light', '#f8fafc');
                document.documentElement.style.setProperty('--text-light', '#1e293b');
                document.documentElement.style.setProperty('--text-gray', '#64748b');
                themeToggleBtn.innerHTML = '<i class="fas fa-sun"></i>';
                themeToggleBtn.style.color = '#f59e0b';
            } else {
                document.documentElement.style.setProperty('--dark-bg', '#0a192f');
                document.documentElement.style.setProperty('--card-bg', '#112240');
                document.documentElement.style.setProperty('--card-bg-light', '#1a2c4d');
                document.documentElement.style.setProperty('--text-light', '#ccd6f6');
                document.documentElement.style.setProperty('--text-gray', '#8892b0');
                themeToggleBtn.innerHTML = '<i class="fas fa-moon"></i>';
                themeToggleBtn.style.color = '#64ffda';
            }
            
            addAchievement(isLightTheme ? 'Включен светлый режим!' : 'Включен темный режим!');
        }
        
        function initSkillProgress() {
            skillCards.forEach(card => {
                const skillValue = card.getAttribute('data-skill');
                const progressBar = card.querySelector('.skill-progress-bar');
                
                setTimeout(() => {
                    progressBar.style.width = `${skillValue}%`;
                }, 300);
            });
        }
        
        function initScrollTop() {
            window.addEventListener('scroll', () => {
                if (window.pageYOffset > 300) {
                    scrollTopBtn.classList.add('active');
                } else {
                    scrollTopBtn.classList.remove('active');
                }
            });
            
            scrollTopBtn.addEventListener('click', () => {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });
        }
        
        function initAnimations() {
            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };
            
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            }, observerOptions);
            
            document.querySelectorAll('.skill-card, .project-card, .motivation-card').forEach(el => {
                el.style.opacity = '0';
                el.style.transform = 'translateY(40px)';
                el.style.transition = 'opacity 0.8s ease, transform 0.8s ease';
                observer.observe(el);
            });
        }
        
        function init() {
            createParticles();
            typeWriter();
            initSkillProgress();
            initScrollTop();
            initAnimations();
            
            setInterval(updateTimeSpent, 1000);
            
            const currentYear = new Date().getFullYear();
            document.querySelector('.year').textContent = currentYear;
            
            clickMeBtn.addEventListener('click', handleClick);
            
            tabButtons.forEach(btn => {
                btn.addEventListener('click', handleTabClick);
            });
            
            themeToggleBtn.addEventListener('click', toggleTheme);
            
            colorButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const color = btn.getAttribute('data-color');
                    handleColorChange(color);
                });
            });
            
            document.querySelectorAll('.code-icons i').forEach((icon, index) => {
                icon.addEventListener('click', () => {
                    if (index === 0) {
                        const code = document.querySelector('pre').textContent;
                        navigator.clipboard.writeText(code).then(() => {
                            const originalIcon = icon.className;
                            icon.className = 'fas fa-check';
                            setTimeout(() => {
                                icon.className = originalIcon;
                            }, 2000);
                        });
                    } else if (index === 1) {
                        alert('Код успешно выполнен! Результат в консоли браузера.');
                    } else if (index === 2) {
                        document.querySelector('.code-display').classList.toggle('expanded');
                    }
                });
            });
            
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    document.querySelector('.code-display').classList.remove('expanded');
                }
            });
            
            const style = document.createElement('style');
            style.textContent = `
                .code-display.expanded {
                    position: fixed;
                    top: 50px;
                    left: 50px;
                    right: 50px;
                    bottom: 50px;
                    z-index: 2000;
                    transform: none !important;
                    max-height: none;
                    overflow: auto;
                }
                
                .code-display.expanded pre {
                    max-height: calc(100vh - 200px);
                    overflow: auto;
                }
                
                .color-btn {
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                    border: 3px solid transparent;
                    cursor: pointer;
                    transition: all 0.3s;
                }
                
                .color-btn:hover {
                    transform: scale(1.2);
                    border-color: white;
                }
                
                .color-btn.active {
                    border-color: white;
                    box-shadow: 0 0 15px currentColor;
                }
            `;
            document.head.appendChild(style);
            
            addAchievement('Добро пожаловать на мою страницу!');
            setTimeout(() => addAchievement('Попробуйте нажать на кнопку!'), 2000);
            setTimeout(() => addAchievement('Измените цвет темы!'), 5000);
        }
        
        document.addEventListener('DOMContentLoaded', init);
    </script>
