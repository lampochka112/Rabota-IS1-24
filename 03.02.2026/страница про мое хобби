                document.documentElement.style.setProperty('--text-light', '#ccd6f6');
                document.documentElement.style.setProperty('--text-gray', '#8892b0');
                themeToggleBtn.innerHTML = '<i class="fas fa-moon"></i>';
                themeToggleBtn.style.color = '#64ffda';
            }
            
            addAchievement(isLightTheme ? 'Включен светлый режим!' : 'Включен темный режим!');
        }
        
        // Инициализация фильтрации проектов
        function initProjectFilter() {
            tabButtons.forEach(btn => {
                btn.addEventListener('click', handleTabClick);
            });
        }
        
        function handleTabClick(event) {
            const filter = event.target.getAttribute('data-filter');
            
            tabButtons.forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            
            projectsContainer.style.opacity = '0';
            projectsContainer.style.transform = 'translateY(30px)';
            
            setTimeout(() => {
                const projectCards = document.querySelectorAll('.project-card');
                
                projectCards.forEach(card => {
                    if (filter === 'all' || card.getAttribute('data-category') === filter) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
                
                projectsContainer.style.opacity = '1';
                projectsContainer.style.transform = 'translateY(0)';
            }, 300);
            
            addAchievement(`Фильтр проектов: ${event.target.textContent}`);
        }
        
        // Инициализация анимаций при прокрутке
        function initScrollAnimations() {
            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };
            
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            }, observerOptions);
            
            document.querySelectorAll('.skill-card, .project-card, .motivation-card, .tech-card').forEach(el => {
                el.style.opacity = '0';
                el.style.transform = 'translateY(40px)';
                el.style.transition = 'opacity 0.8s ease, transform 0.8s ease';
                observer.observe(el);
            });
        }
        
        // Инициализация копирования кода
        function initCodeCopy() {
            document.querySelectorAll('.code-icons i').forEach((icon, index) => {
                icon.addEventListener('click', () => {
                    if (index === 0) {
                        const code = document.querySelector('pre').textContent;
                        navigator.clipboard.writeText(code).then(() => {
                            const originalIcon = icon.className;
                            icon.className = 'fas fa-check';
                            setTimeout(() => {
                                icon.className = originalIcon;
                            }, 2000);
                            addAchievement('Код скопирован в буфер обмена!');
                        });
                    } else if (index === 1) {
                        alert('Код успешно выполнен! Результат в консоли браузера.');
                        addAchievement('Код выполнен!');
                    } else if (index === 2) {
                        document.querySelector('.code-display').classList.toggle('expanded');
                        addAchievement('Режим полноэкранного просмотра кода!');
                    }
                });
            });
        }
        
        // Основная инициализация
        function init() {
            createParticles();
            createCodeBackground();
            typeWriter();
            initNavigation();
            initSkillProgress();
            initScrollTop();
            initThemeToggle();
            initProjectFilter();
            initScrollAnimations();
            initCodeCopy();
            simulateLiveUsers();
            
            setInterval(updateTimeSpent, 1000);
            
            // Установка текущего года
            const currentYear = new Date().getFullYear();
            document.querySelector('.year').textContent = currentYear;
            
            // Обработчики событий
            clickMeBtn.addEventListener('click', handleClick);
            
            colorButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const color = btn.getAttribute('data-color');
                    handleColorChange(color);
                });
            });
            
            generateCodeBtn.addEventListener('click', generateRandomCode);
            animateCodeBtn.addEventListener('click', animateCode);
            clearOutputBtn.addEventListener('click', clearCodeOutput);
            pauseAnimationsBtn.addEventListener('click', pauseAllAnimations);
            resumeAnimationsBtn.addEventListener('click', resumeAllAnimations);
            randomizeColorsBtn.addEventListener('click', randomizeAllColors);
            showDemoBtn.addEventListener('click', showDemoModal);
            modalClose.addEventListener('click', hideDemoModal);
            scrollToProjectsBtn.addEventListener('click', scrollToProjects);
            startTutorialBtn.addEventListener('click', startTutorial);
            showTechBtn.addEventListener('click', showTechAnimation);
            
            // Закрытие модального окна при клике вне его
            demoModal.addEventListener('click', (e) => {
                if (e.target === demoModal) {
                    hideDemoModal();
                }
            });
            
            // Анимация карточек технологий при наведении
            document.querySelectorAll('.tech-card').forEach(card => {
                card.addEventListener('click', () => {
                    card.style.transform = 'translateY(-30px) rotateY(180deg) scale(1.2)';
                    setTimeout(() => {
                        card.style.transform = 'translateY(-20px) rotateY(10deg)';
                    }, 600);
                    addAchievement('Карточка технологии активирована!');
                });
            });
            
            // Добавление стилей для модального окна
            const style = document.createElement('style');
            style.textContent = `
                .code-display.expanded {
                    position: fixed;
                    top: 50px;
                    left: 50px;
                    right: 50px;
                    bottom: 50px;
                    z-index: 2000;
                    transform: none !important;
                    max-height: none;
                    overflow: auto;
                }
                
                .code-display.expanded pre {
                    max-height: calc(100vh - 200px);
                    overflow: auto;
                }
                
                .color-btn {
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                    border: 3px solid transparent;
                    cursor: pointer;
                    transition: all 0.3s;
                }
                
                .color-btn:hover {
                    transform: scale(1.2);
                    border-color: white;
                }
                
                .color-btn.active {
                    border-color: white;
                    box-shadow: 0 0 15px currentColor;
                }
                
                .demo-controls {
                    margin-top: 30px;
                }
                
                .demo-controls input[type="range"] {
                    -webkit-appearance: none;
                    height: 8px;
                    background: rgba(100, 255, 218, 0.2);
                    border-radius: 4px;
                    outline: none;
                }
                
                .demo-controls input[type="range"]::-webkit-slider-thumb {
                    -webkit-appearance: none;
                    width: 20px;
                    height: 20px;
                    background: var(--primary-color);
                    border-radius: 50%;
                    cursor: pointer;
                }
            `;
            document.head.appendChild(style);
            
            // Начальные достижения
            addAchievement('Добро пожаловать на мою страницу!');
            setTimeout(() => addAchievement('Попробуйте нажать на кнопку!'), 2000);
            setTimeout(() => addAchievement('Измените цвет темы!'), 5000);
            setTimeout(() => addAchievement('Исследуйте все интерактивные элементы!'), 8000);
        }
        
        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>
