<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Мое хобби - программирование</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;800&family=Roboto+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #64ffda;
            --secondary-color: #00a8ff;
            --accent-1: #c678dd;
            --accent-2: #e6c07b;
            --accent-3: #e06c75;
            --dark-bg: #0a192f;
            --card-bg: #112240;
            --card-bg-light: #1a2c4d;
            --text-light: #ccd6f6;
            --text-gray: #8892b0;
            --transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            --glow-shadow: 0 0 20px rgba(100, 255, 218, 0.3);
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            background-color: var(--dark-bg);
            color: var(--text-light);
            font-family: 'Montserrat', sans-serif;
            line-height: 1.8;
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(100, 255, 218, 0.07) 0%, transparent 25%),
                radial-gradient(circle at 90% 80%, rgba(0, 168, 255, 0.07) 0%, transparent 25%),
                radial-gradient(circle at 50% 50%, rgba(198, 120, 221, 0.05) 0%, transparent 35%);
            position: relative;
        }
        
        .floating-shapes {
            position: fixed;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
        }
        
        .shape {
            position: absolute;
            border-radius: 50%;
            opacity: 0.1;
            filter: blur(40px);
        }
        
        .shape-1 {
            width: 400px;
            height: 400px;
            background: var(--primary-color);
            top: 10%;
            left: 5%;
            animation: float 20s infinite ease-in-out;
        }
        
        .shape-2 {
            width: 300px;
            height: 300px;
            background: var(--secondary-color);
            bottom: 15%;
            right: 10%;
            animation: float 25s infinite ease-in-out reverse;
        }
        
        .shape-3 {
            width: 250px;
            height: 250px;
            background: var(--accent-1);
            top: 40%;
            right: 20%;
            animation: float 18s infinite ease-in-out;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-30px) rotate(180deg); }
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 40px;
        }
        
        header {
            padding: 150px 0 80px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .particles {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: -1;
        }
        
        .particle {
            position: absolute;
            width: 4px;
            height: 4px;
            background: var(--primary-color);
            border-radius: 50%;
            opacity: 0.4;
        }
        
        .header-content {
            position: relative;
            z-index: 2;
        }
        
        h1 {
            font-size: 4.5rem;
            margin-bottom: 25px;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color), var(--accent-1));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
            letter-spacing: 1.5px;
            font-weight: 800;
            position: relative;
            display: inline-block;
        }
        
        h1::after {
            content: '';
            position: absolute;
            bottom: -15px;
            left: 50%;
            transform: translateX(-50%);
            width: 200px;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            border-radius: 2px;
        }
        
        .tagline {
            font-size: 1.9rem;
            color: var(--text-gray);
            margin-bottom: 50px;
            font-weight: 300;
            max-width: 850px;
            margin-left: auto;
            margin-right: auto;
            line-height: 1.6;
        }
        
        .typewriter-cursor {
            display: inline-block;
            width: 3px;
            height: 1.9rem;
            background-color: var(--primary-color);
            margin-left: 5px;
            animation: blink 1s infinite;
            vertical-align: text-bottom;
        }
        
        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }
        
        .intro {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 120px;
            gap: 70px;
            flex-wrap: wrap;
            position: relative;
        }
        
        .intro::before {
            content: '';
            position: absolute;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(100, 255, 218, 0.1) 0%, transparent 70%);
            top: -50px;
            left: -50px;
            z-index: -1;
        }
        
        .intro-text {
            flex: 1;
            min-width: 300px;
            position: relative;
        }
        
        .intro-text h2 {
            font-size: 3.2rem;
            margin-bottom: 35px;
            color: var(--primary-color);
            position: relative;
            display: inline-block;
        }
        
        .intro-text h2::after {
            content: '';
            position: absolute;
            bottom: -12px;
            left: 0;
            width: 120px;
            height: 5px;
            background: linear-gradient(90deg, var(--primary-color), transparent);
            border-radius: 3px;
        }
        
        .intro-text p {
            font-size: 1.3rem;
            margin-bottom: 28px;
            color: var(--text-gray);
            line-height: 1.9;
            position: relative;
            padding-left: 20px;
            border-left: 3px solid transparent;
            transition: var(--transition);
        }
        
        .intro-text p:hover {
            border-left: 3px solid var(--primary-color);
            padding-left: 25px;
            background: linear-gradient(90deg, rgba(100, 255, 218, 0.05), transparent);
        }
        
        .highlight {
            color: var(--primary-color);
            font-weight: 600;
            text-shadow: 0 0 10px rgba(100, 255, 218, 0.3);
            position: relative;
            display: inline-block;
        }
        
        .highlight::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 2px;
            background: var(--primary-color);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s;
        }
        
        .highlight:hover::after {
            transform: scaleX(1);
        }
        
        .code-display-wrapper {
            flex: 1;
            min-width: 300px;
            position: relative;
        }
        
        .code-display {
            background-color: var(--card-bg);
            border-radius: 20px;
            padding: 35px;
            box-shadow: 
                0 25px 60px rgba(0, 0, 0, 0.5),
                inset 0 1px 0 rgba(255, 255, 255, 0.1);
            border-left: 8px solid var(--primary-color);
            position: relative;
            overflow: hidden;
            transition: var(--transition);
            z-index: 1;
        }
        
        .code-display::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, transparent, rgba(100, 255, 218, 0.03), transparent);
            z-index: -1;
        }
        
        .code-display::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(
                transparent,
                var(--primary-color),
                transparent 30%
            );
            animation: rotate 10s linear infinite;
            z-index: -2;
        }
        
        @keyframes rotate {
            100% { transform: rotate(360deg); }
        }
        
        .code-display:hover {
            transform: translateY(-15px) scale(1.02);
            box-shadow: 
                0 35px 80px rgba(0, 0, 0, 0.6),
                var(--glow-shadow),
                inset 0 1px 0 rgba(255, 255, 255, 0.1);
        }
        
        .code-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            color: var(--primary-color);
        }
        
        .code-title {
            font-family: 'Roboto Mono', monospace;
            font-weight: 600;
            font-size: 1.3rem;
            letter-spacing: 1.5px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .code-title::before {
            content: '❯';
            color: var(--accent-3);
        }
        
        .code-icons {
            display: flex;
            gap: 15px;
        }
        
        .code-icons i {
            cursor: pointer;
            transition: var(--transition);
            font-size: 1.3rem;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: rgba(100, 255, 218, 0.1);
        }
        
        .code-icons i:hover {
            color: var(--secondary-color);
            transform: translateY(-5px);
            background: rgba(100, 255, 218, 0.2);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }
        
        pre {
            overflow-x: auto;
            font-family: 'Roboto Mono', monospace;
            font-size: 1.15rem;
            line-height: 1.8;
            padding: 20px;
            border-radius: 12px;
            background-color: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(100, 255, 218, 0.1);
            position: relative;
            z-index: 2;
        }
        
        .code-line {
            display: block;
            margin-bottom: 5px;
            position: relative;
            padding-left: 20px;
        }
        
        .code-line::before {
            content: attr(data-line);
            position: absolute;
            left: 0;
            color: var(--text-gray);
            font-size: 0.9rem;
            width: 20px;
            text-align: right;
        }
        
        .code-keyword {
            color: var(--accent-1);
            font-weight: 600;
        }
        
        .code-function {
            color: #50fa7b;
        }
        
        .code-string {
            color: var(--accent-2);
        }
        
        .code-comment {
            color: #6272a4;
            font-style: italic;
        }
        
        .code-var {
            color: var(--secondary-color);
        }
        
        .code-number {
            color: var(--accent-3);
        }
        
        .section-title {
            text-align: center;
            font-size: 3.5rem;
            margin-bottom: 90px;
            color: var(--primary-color);
            position: relative;
            padding-bottom: 25px;
        }
        
        .section-title::after {
            content: '';
            display: block;
            width: 180px;
            height: 6px;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color), var(--accent-1));
            margin: 25px auto;
            border-radius: 3px;
            position: relative;
            overflow: hidden;
        }
        
        .section-title::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(100, 255, 218, 0.3), transparent);
        }
        
        .skills {
            margin-bottom: 140px;
        }
        
        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
            gap: 50px;
        }
        
        .skill-card {
            background: linear-gradient(145deg, var(--card-bg), var(--card-bg-light));
            border-radius: 20px;
            padding: 45px 35px;
            text-align: center;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
            border: 1px solid transparent;
            background-clip: padding-box;
        }
        
        .skill-card::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            background: linear-gradient(45deg, var(--primary-color), var(--secondary-color), var(--accent-1));
            border-radius: 22px;
            z-index: -1;
            opacity: 0;
            transition: opacity 0.5s;
        }
        
        .skill-card:hover::before {
            opacity: 1;
        }
        
        .skill-card:hover {
            transform: translateY(-20px) scale(1.03);
            box-shadow: 
                0 35px 70px rgba(0, 0, 0, 0.5),
                var(--glow-shadow);
        }
        
        .skill-icon-wrapper {
            width: 100px;
            height: 100px;
            margin: 0 auto 30px;
            background: linear-gradient(135deg, rgba(100, 255, 218, 0.1), rgba(0, 168, 255, 0.1));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            transition: var(--transition);
        }
        
        .skill-card:hover .skill-icon-wrapper {
            transform: rotateY(360deg);
            background: linear-gradient(135deg, rgba(100, 255, 218, 0.2), rgba(0, 168, 255, 0.2));
        }
        
        .skill-icon {
            font-size: 3.8rem;
            color: var(--primary-color);
            transition: var(--transition);
        }
        
        .skill-card:hover .skill-icon {
            filter: drop-shadow(0 0 10px rgba(100, 255, 218, 0.5));
        }
        
        .skill-card h3 {
            font-size: 2.2rem;
            margin-bottom: 25px;
            color: var(--text-light);
            position: relative;
            display: inline-block;
        }
        
        .skill-card h3::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 3px;
            background: var(--primary-color);
            border-radius: 2px;
        }
        
        .skill-card p {
            color: var(--text-gray);
            font-size: 1.2rem;
            line-height: 1.9;
        }
        
        .skill-progress {
            margin-top: 25px;
            height: 8px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            overflow: hidden;
            position: relative;
        }
        
        .skill-progress-bar {
            height: 100%;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            border-radius: 4px;
            width: 0;
            transition: width 1.5s ease-in-out;
            position: relative;
        }
        
        .skill-progress-bar::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            animation: shimmer 2s infinite;
        }
        
        @keyframes shimmer {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }
        
        .projects {
            margin-bottom: 140px;
        }
        
        .projects-tabs {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 50px;
            flex-wrap: wrap;
        }
        
        .tab-btn {
            padding: 15px 35px;
            background: transparent;
            color: var(--text-gray);
            border: 2px solid rgba(100, 255, 218, 0.3);
            border-radius: 50px;
            font-size: 1.2rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }
        
        .tab-btn::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0);
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            border-radius: 50px;
            transition: transform 0.5s;
            z-index: -1;
        }
        
        .tab-btn.active {
            color: var(--dark-bg);
            border-color: transparent;
        }
        
        .tab-btn.active::before {
            transform: translate(-50%, -50%) scale(1);
        }
        
        .tab-btn:hover:not(.active) {
            color: var(--primary-color);
            border-color: var(--primary-color);
            transform: translateY(-5px);
        }
        
        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
            gap: 50px;
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.5s, transform 0.5s;
        }
        
        .projects-grid.active {
            opacity: 1;
            transform: translateY(0);
        }
        
        .project-card {
            background: linear-gradient(145deg, var(--card-bg), var(--card-bg-light));
            border-radius: 20px;
            overflow: hidden;
            transition: var(--transition);
            position: relative;
            border: 1px solid rgba(100, 255, 218, 0.1);
        }
        
        .project-card:hover {
            transform: translateY(-20px) scale(1.03);
            box-shadow: 
                0 35px 70px rgba(0, 0, 0, 0.5),
                0 0 30px rgba(100, 255, 218, 0.2);
            border-color: var(--primary-color);
        }
        
        .project-img {
            height: 250px;
            background: linear-gradient(135deg, #0a192f, var(--card-bg));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 5rem;
            color: var(--primary-color);
            position: relative;
            overflow: hidden;
        }
        
        .project-img::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, rgba(100, 255, 218, 0.1), transparent);
        }
        
        .project-img i {
            filter: drop-shadow(0 0 10px rgba(100, 255, 218, 0.3));
            transition: var(--transition);
        }
        
        .project-card:hover .project-img i {
            transform: scale(1.2) rotate(10deg);
        }
        
        .project-info {
            padding: 35px;
        }
        
        .project-info h3 {
            font-size: 2rem;
            margin-bottom: 20px;
            color: var(--text-light);
            position: relative;
            display: inline-block;
        }
        
        .project-info h3::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 60px;
            height: 3px;
            background: var(--primary-color);
            border-radius: 2px;
        }
        
        .project-info p {
            color: var(--text-gray);
            margin-bottom: 30px;
            font-size: 1.2rem;
            line-height: 1.8;
        }
        
        .project-tech {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
        }
        
        .tech-tag {
            background: rgba(100, 255, 218, 0.1);
            color: var(--primary-color);
            padding: 10px 20px;
            border-radius: 25px;
            font-size: 1rem;
            font-family: 'Roboto Mono', monospace;
            border: 1px solid rgba(100, 255, 218, 0.3);
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .tech-tag i {
            font-size: 0.9rem;
        }
        
        .tech-tag:hover {
            background: rgba(100, 255, 218, 0.2);
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }
        
        .about {
            margin-bottom: 140px;
            background: linear-gradient(145deg, var(--card-bg), var(--card-bg-light));
            border-radius: 30px;
            padding: 70px;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(100, 255, 218, 0.1);
        }
        
        .about::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(100, 255, 218, 0.1) 0%, transparent 70%);
        }
        
        .about::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(0, 168, 255, 0.1) 0%, transparent 70%);
        }
        
        .about h2 {
            font-size: 3.2rem;
            margin-bottom: 40px;
            color: var(--primary-color);
            position: relative;
            display: inline-block;
        }
        
        .about h2::after {
            content: '';
            position: absolute;
            bottom: -12px;
            left: 0;
            width: 150px;
            height: 5px;
            background: linear-gradient(90deg, var(--primary-color), transparent);
            border-radius: 3px;
        }
        
        .about-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 60px;
            position: relative;
            z-index: 1;
        }
        
        .about-text {
            font-size: 1.3rem;
            color: var(--text-gray);
            line-height: 1.9;
        }
        
        .about-text p {
            margin-bottom: 30px;
            position: relative;
            padding-left: 25px;
        }
        
        .about-text p::before {
            content: '▸';
            position: absolute;
            left: 0;
            color: var(--primary-color);
            font-size: 1.5rem;
        }
        
        .motivation-cards {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }
        
        .motivation-card {
            background: rgba(0, 0, 0, 0.2);
            border-radius: 15px;
            padding: 25px;
            transition: var(--transition);
            border-left: 5px solid var(--primary-color);
        }
        
        .motivation-card:hover {
            transform: translateX(10px);
            background: rgba(0, 0, 0, 0.3);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
        }
        
        .motivation-card h4 {
            font-size: 1.5rem;
            margin-bottom: 15px;
            color: var(--text-light);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .motivation-card h4 i {
            color: var(--primary-color);
        }
        
        .motivation-card p {
            color: var(--text-gray);
            font-size: 1.1rem;
            line-height: 1.7;
            margin: 0;
            padding: 0;
        }
        
        .motivation-card p::before {
            display: none;
        }
        
        .fun-element {
            text-align: center;
            margin: 100px 0;
            padding: 70px;
            background: linear-gradient(145deg, var(--card-bg), var(--card-bg-light));
            border-radius: 30px;
            box-shadow: 
                0 30px 80px rgba(0, 0, 0, 0.4),
                inset 0 1px 0 rgba(255, 255, 255, 0.1);
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(100, 255, 218, 0.1);
        }
        
        .fun-element::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
