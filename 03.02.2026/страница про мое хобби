<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Мое хобби - программирование</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background-color: #0a192f;
            color: #ccd6f6;
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        header {
            padding: 80px 0 40px;
            text-align: center;
        }
        
        h1 {
            font-size: 3.5rem;
            margin-bottom: 15px;
            background: linear-gradient(90deg, #64ffda, #00a8ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .tagline {
            font-size: 1.5rem;
            color: #8892b0;
            margin-bottom: 30px;
        }
        
        .intro {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 80px;
            flex-wrap: wrap;
        }
        
        .intro-text {
            flex: 1;
            min-width: 300px;
            padding-right: 40px;
        }
        
        .intro-text h2 {
            font-size: 2.5rem;
            margin-bottom: 20px;
            color: #64ffda;
        }
        
        .intro-text p {
            font-size: 1.2rem;
            margin-bottom: 20px;
            color: #a8b2d1;
        }
        
        .code-display {
            flex: 1;
            min-width: 300px;
            background-color: #112240;
            border-radius: 10px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            border-left: 5px solid #64ffda;
        }
        
        .code-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            color: #64ffda;
        }
        
        .code-title {
            font-weight: 600;
        }
        
        .code-icons i {
            margin-left: 10px;
            cursor: pointer;
            transition: color 0.3s;
        }
        
        .code-icons i:hover {
            color: #00a8ff;
        }
        
        pre {
            overflow-x: auto;
            font-family: 'Courier New', monospace;
            font-size: 1rem;
            line-height: 1.5;
        }
        
        .code-keyword {
            color: #ff79c6;
        }
        
        .code-function {
            color: #50fa7b;
        }
        
        .code-string {
            color: #f1fa8c;
        }
        
        .code-comment {
            color: #6272a4;
        }
        
        .skills {
            margin-bottom: 80px;
        }
        
        .section-title {
            text-align: center;
            font-size: 2.5rem;
            margin-bottom: 50px;
            color: #64ffda;
            position: relative;
        }
        
        .section-title::after {
            content: '';
            display: block;
            width: 100px;
            height: 3px;
            background: #64ffda;
            margin: 15px auto;
        }
        
        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }
        
        .skill-card {
            background-color: #112240;
            border-radius: 10px;
            padding: 30px;
            text-align: center;
            transition: transform 0.3s, box-shadow 0.3s;
            border-top: 5px solid #64ffda;
        }
        
        .skill-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        }
        
        .skill-icon {
            font-size: 3rem;
            color: #64ffda;
            margin-bottom: 20px;
        }
        
        .skill-card h3 {
            font-size: 1.8rem;
            margin-bottom: 15px;
            color: #ccd6f6;
        }
        
        .skill-card p {
            color: #a8b2d1;
        }
        
        .projects {
            margin-bottom: 80px;
        }
        
        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }
        
        .project-card {
            background-color: #112240;
            border-radius: 10px;
            overflow: hidden;
            transition: transform 0.3s;
        }
        
        .project-card:hover {
            transform: translateY(-10px);
        }
        
        .project-img {
            height: 200px;
            background: linear-gradient(135deg, #0a192f, #112240);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 4rem;
            color: #64ffda;
        }
        
        .project-info {
            padding: 25px;
        }
        
        .project-info h3 {
            font-size: 1.5rem;
            margin-bottom: 10px;
            color: #ccd6f6;
        }
        
        .project-info p {
            color: #a8b2d1;
            margin-bottom: 20px;
        }
        
        .project-tech {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }
        
        .tech-tag {
            background-color: #233554;
            color: #64ffda;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
        }
        
        .contact {
            text-align: center;
            padding: 60px 0;
            background-color: #0c1a35;
            border-radius: 15px;
            margin-bottom: 80px;
        }
        
        .contact h2 {
            font-size: 2.5rem;
            margin-bottom: 20px;
            color: #64ffda;
        }
        
        .contact p {
            font-size: 1.2rem;
            max-width: 600px;
            margin: 0 auto 30px;
            color: #a8b2d1;
        }
        
        .btn {
            display: inline-block;
            background-color: transparent;
            color: #64ffda;
            border: 2px solid #64ffda;
            padding: 12px 30px;
            border-radius: 5px;
            text-decoration: none;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s;
            cursor: pointer;
        }
        
        .btn:hover {
            background-color: rgba(100, 255, 218, 0.1);
            transform: translateY(-3px);
        }
        
        footer {
            text-align: center;
            padding: 30px 0;
            color: #8892b0;
            border-top: 1px solid #233554;
        }
        
        .social-links {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 20px;
        }
        
        .social-links a {
            color: #ccd6f6;
            font-size: 1.5rem;
            transition: color 0.3s;
        }
        
        .social-links a:hover {
            color: #64ffda;
        }
        
        .fun-element {
            text-align: center;
            margin: 40px 0;
        }
        
        #clickCounter {
            font-size: 1.5rem;
            color: #64ffda;
            margin-top: 15px;
        }
        
        @media (max-width: 768px) {
            h1 {
                font-size: 2.5rem;
            }
            
            .intro {
                flex-direction: column;
            }
            
            .intro-text {
                padding-right: 0;
                margin-bottom: 40px;
            }
            
            .section-title {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>Мое хобби - программирование</h1>
            <p class="tagline">Страсть к созданию вещей с помощью кода</p>
        </header>
        
        <section class="intro">
            <div class="intro-text">
                <h2>Привет! Меня зовут Даниил</h2>
                <p>Я увлечен программированием и веб-разработкой. Для меня это не просто хобби, а способ творческого самовыражения и решения интересных задач.</p>
                <p>Особенно я люблю работать с <strong>HTML</strong> и <strong>JavaScript</strong>, потому что они позволяют создавать интерактивные и визуально привлекательные веб-страницы, которые можно сразу увидеть в действии.</p>
                <p>Программирование для меня — это как искусство, где код становится кистью, а браузер — холстом.</p>
            </div>
            
            <div class="code-display">
                <div class="code-header">
                    <div class="code-title">hobby.js</div>
                    <div class="code-icons">
                        <i class="fas fa-copy" title="Скопировать код"></i>
                        <i class="fas fa-play" title="Запустить код"></i>
                    </div>
                </div>
                <pre><code><span class="code-keyword">const</span> <span class="code-function">myHobby</span> = {
  <span class="code-string">"любимые_технологии"</span>: [<span class="code-string">"HTML"</span>, <span class="code-string">"JavaScript"</span>, <span class="code-string">"CSS"</span>],
  <span class="code-string">"уровень_энтузиазма"</span>: <span class="code-string">"максимальный"</span>,
  <span class="code-string">"цель"</span>: <span class="code-string">"создавать полезные и красивые веб-приложения"</span>,
  
  <span class="code-function">начатьКодить</span>() {
    <span class="code-keyword">return</span> <span class="code-string">`Я люблю программировать на ${this.любимые_технологии[0]} и ${this.любимые_технологии[1]}!`</span>;
  }
};

<span class="code-comment">// Вывод в консоль</span>
console.<span class="code-function">log</span>(myHobby.<span class="code-function">начатьКодить</span>());
<span class="code-comment">// Результат: "Я люблю программировать на HTML и JavaScript!"</span></code></pre>
            </div>
        </section>
        
        <section class="skills">
            <h2 class="section-title">Мои навыки</h2>
            <div class="skills-grid">
                <div class="skill-card">
                    <div class="skill-icon">
                        <i class="fab fa-html5"></i>
                    </div>
                    <h3>HTML5</h3>
                    <p>Создание семантической и доступной структуры веб-страниц с использованием современных стандартов HTML5.</p>
                </div>
                
                <div class="skill-card">
                    <div class="skill-icon">
                        <i class="fab fa-js-square"></i>
                    </div>
                    <h3>JavaScript</h3>
                    <p>Разработка интерактивных элементов, анимаций и логики веб-приложений с помощью чистого JavaScript.</p>
                </div>
                
                <div class="skill-card">
                    <div class="skill-icon">
                        <i class="fab fa-css3-alt"></i>
                    </div>
                    <h3>CSS3</h3>
                    <p>Стилизация и оформление веб-страниц с использованием современных возможностей CSS3, Flexbox и Grid.</p>
                </div>
            </div>
        </section>
        
        <section class="projects">
            <h2 class="section-title">Примеры проектов</h2>
            <div class="projects-grid">
                <div class="project-card">
                    <div class="project-img">
                        <i class="fas fa-gamepad"></i>
                    </div>
                    <div class="project-info">
                        <h3>Браузерная игра</h3>
                        <p>Игра "Змейка", созданная с использованием чистого JavaScript, HTML5 Canvas и CSS анимаций.</p>
                        <div class="project-tech">
                            <span class="tech-tag">HTML5</span>
                            <span class="tech-tag">JavaScript</span>
                            <span class="tech-tag">Canvas API</span>
                        </div>
                    </div>
                </div>
                
                <div class="project-card">
                    <div class="project-img">
                        <i class="fas fa-tasks"></i>
                    </div>
                    <div class="project-info">
                        <h3>Трекер задач</h3>
                        <p>Веб-приложение для управления задачами с возможностью добавления, редактирования и отметки выполненных.</p>
                        <div class="project-tech">
                            <span class="tech-tag">HTML</span>
                            <span class="tech-tag">CSS</span>
                            <span class="tech-tag">JavaScript</span>
                            <span class="tech-tag">LocalStorage</span>
                        </div>
                    </div>
                </div>
                
                <div class="project-card">
                    <div class="project-img">
                        <i class="fas fa-cloud-sun"></i>
                    </div>
                    <div class="project-info">
                        <h3>Погодное приложение</h3>
                        <p>Виджет погоды с использованием API для получения актуальных данных о погоде в разных городах.</p>
                        <div class="project-tech">
                            <span class="tech-tag">HTML</span>
                            <span class="tech-tag">CSS</span>
                            <span class="tech-tag">JavaScript</span>
                            <span class="tech-tag">Fetch API</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <div class="fun-element">
            <h3>Интерактивный элемент на JavaScript</h3>
            <p>Нажмите на кнопку, чтобы увидеть JavaScript в действии:</p>
            <button id="clickMeBtn" class="btn">Нажми меня!</button>
            <div id="clickCounter">Количество нажатий: 0</div>
        </div>
        
        <section class="contact">
            <h2>Давайте создавать вместе!</h2>
            <p>Если вы тоже увлекаетесь программированием или хотите обсудить интересные проекты, напишите мне!</p>
            <a href="mailto:example@domain.com" class="btn">Связаться со мной</a>
        </section>
        
        <footer>
            <div class="social-links">
                <a href="#"><i class="fab fa-github"></i></a>
                <a href="#"><i class="fab fa-codepen"></i></a>
                <a href="#"><i class="fab fa-dev"></i></a>
                <a href="#"><i class="fab fa-linkedin"></i></a>
            </div>
            <p>Страница создана с помощью HTML, CSS и JavaScript</p>
            <p>&copy; 2026 Моё хобби - программирование</p>
        </footer>
    </div>

    <script>
        // Интерактивный счетчик нажатий
        let clickCount = 0;
        const clickMeBtn = document.getElementById('clickMeBtn');
        const clickCounter = document.getElementById('clickCounter');
        
        clickMeBtn.addEventListener('click', function() {
            clickCount++;
            clickCounter.textContent = `Количество нажатий: ${clickCount}`;
            
            // Добавляем случайный цвет для кнопки
            const colors = ['#64ffda', '#00a8ff', '#ff79c6', '#50fa7b', '#f1fa8c'];
            const randomColor = colors[Math.floor(Math.random() * colors.length)];
            clickMeBtn.style.borderColor = randomColor;
            clickMeBtn.style.color = randomColor;
            
            // Добавляем небольшой эффект анимации
            clickMeBtn.style.transform = 'scale(0.95)';
            setTimeout(() => {
                clickMeBtn.style.transform = 'scale(1)';
            }, 150);
        });
        
        // Копирование кода при нажатии на иконку
        document.querySelector('.fa-copy').addEventListener('click', function() {
            const code = document.querySelector('pre').textContent;
            navigator.clipboard.writeText(code).then(() => {
                const originalTitle = this.title;
                this.title = 'Код скопирован!';
                setTimeout(() => {
                    this.title = originalTitle;
                }, 2000);
            });
        });
        
        // Эмуляция запуска кода при нажатии на иконку play
        document.querySelector('.fa-play').addEventListener('click', function() {
            alert('Результат выполнения кода: "Я люблю программировать на HTML и JavaScript!"');
        });
        
        // Плавная анимация при прокрутке
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };
        
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);
        
        // Наблюдаем за элементами для анимации
        document.querySelectorAll('.skill-card, .project-card').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(20px)';
            el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            observer.observe(el);
        });
    </script>
</body>
</html>
