        // Генерация случайного кода
        function generateRandomCode() {
            const codeSnippets = [
                "function fibonacci(n) {\n  if (n <= 1) return n;\n  return fibonacci(n-1) + fibonacci(n-2);\n}",
                "const debounce = (fn, delay) => {\n  let timeout;\n  return (...args) => {\n    clearTimeout(timeout);\n    timeout = setTimeout(() => fn(...args), delay);\n  };\n};",
                "class Observable {\n  constructor() {\n    this.subscribers = [];\n  }\n  subscribe(fn) {\n    this.subscribers.push(fn);\n  }\n  notify(data) {\n    this.subscribers.forEach(fn => fn(data));\n  }\n}",
                "const deepClone = (obj) => {\n  if (obj === null || typeof obj !== 'object') return obj;\n  const clone = Array.isArray(obj) ? [] : {};\n  for (let key in obj) {\n    clone[key] = deepClone(obj[key]);\n  }\n  return clone;\n};",
                "async function fetchWithRetry(url, retries = 3) {\n  try {\n    const response = await fetch(url);\n    if (!response.ok) throw new Error('Request failed');\n    return await response.json();\n  } catch (error) {\n    if (retries === 0) throw error;\n    return fetchWithRetry(url, retries - 1);\n  }\n}"
            ];
            
            const randomCode = codeSnippets[Math.floor(Math.random() * codeSnippets.length)];
            const codeLine = document.createElement('div');
            codeLine.classList.add('code-output-line');
            codeLine.textContent = randomCode;
            codeLine.style.opacity = '0';
            
            codeOutput.appendChild(codeLine);
            
            // Анимация появления
            setTimeout(() => {
                codeLine.style.transition = 'opacity 0.5s';
                codeLine.style.opacity = '1';
            }, 10);
            
            // Прокрутка к новому коду
            codeOutput.scrollTop = codeOutput.scrollHeight;
            
            addAchievement('Сгенерирован новый код!');
        }
        
