<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Мое хобби - программирование</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&family=Roboto+Mono:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #64ffda;
            --secondary-color: #00a8ff;
            --dark-bg: #0a192f;
            --card-bg: #112240;
            --text-light: #ccd6f6;
            --text-gray: #8892b0;
            --accent-purple: #c678dd;
            --accent-yellow: #e6c07b;
            --transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.1);
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            background-color: var(--dark-bg);
            color: var(--text-light);
            font-family: 'Montserrat', sans-serif;
            line-height: 1.8;
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 20% 30%, rgba(100, 255, 218, 0.05) 0%, transparent 20%),
                radial-gradient(circle at 80% 70%, rgba(0, 168, 255, 0.05) 0%, transparent 20%);
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 30px;
        }
        
        header {
            padding: 120px 0 60px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .header-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                linear-gradient(45deg, rgba(100, 255, 218, 0.1) 0%, transparent 50%),
                linear-gradient(-45deg, rgba(0, 168, 255, 0.1) 0%, transparent 50%);
            z-index: -1;
        }
        
        h1 {
            font-size: 4.2rem;
            margin-bottom: 20px;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color), var(--accent-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            letter-spacing: 1px;
        }
        
        .tagline {
            font-size: 1.8rem;
            color: var(--text-gray);
            margin-bottom: 40px;
            font-weight: 300;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }
        
        .intro {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 100px;
            gap: 60px;
            flex-wrap: wrap;
        }
        
        .intro-text {
            flex: 1;
            min-width: 300px;
        }
        
        .intro-text h2 {
            font-size: 3rem;
            margin-bottom: 30px;
            color: var(--primary-color);
            position: relative;
            display: inline-block;
        }
        
        .intro-text h2::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 100px;
            height: 4px;
            background: var(--primary-color);
            border-radius: 2px;
        }
        
        .intro-text p {
            font-size: 1.25rem;
            margin-bottom: 25px;
            color: var(--text-gray);
            line-height: 1.8;
        }
        
        .intro-text .highlight {
            color: var(--primary-color);
            font-weight: 600;
        }
        
        .code-display {
            flex: 1;
            min-width: 300px;
            background-color: var(--card-bg);
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
            border-left: 6px solid var(--primary-color);
            position: relative;
            overflow: hidden;
            transition: var(--transition);
        }
        
        .code-display::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
        }
        
        .code-display:hover {
            transform: translateY(-10px);
            box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5);
        }
        
        .code-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            color: var(--primary-color);
        }
        
        .code-title {
            font-family: 'Roboto Mono', monospace;
            font-weight: 600;
            font-size: 1.2rem;
            letter-spacing: 1px;
        }
        
        .code-icons i {
            margin-left: 15px;
            cursor: pointer;
            transition: var(--transition);
            font-size: 1.2rem;
        }
        
        .code-icons i:hover {
            color: var(--secondary-color);
            transform: scale(1.2);
        }
        
        pre {
            overflow-x: auto;
            font-family: 'Roboto Mono', monospace;
            font-size: 1.1rem;
            line-height: 1.7;
            padding: 10px;
            border-radius: 8px;
            background-color: rgba(0, 0, 0, 0.2);
        }
        
        .code-keyword {
            color: var(--accent-purple);
        }
        
        .code-function {
            color: #50fa7b;
        }
        
        .code-string {
            color: var(--accent-yellow);
        }
        
        .code-comment {
            color: #6272a4;
            font-style: italic;
        }
        
        .code-var {
            color: var(--secondary-color);
        }
        
        .section-title {
            text-align: center;
            font-size: 3rem;
            margin-bottom: 70px;
            color: var(--primary-color);
            position: relative;
        }
        
        .section-title::after {
            content: '';
            display: block;
            width: 150px;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            margin: 20px auto;
            border-radius: 2px;
        }
        
        .skills {
            margin-bottom: 120px;
        }
        
        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 40px;
        }
        
        .skill-card {
            background-color: var(--card-bg);
            border-radius: 15px;
            padding: 40px 30px;
            text-align: center;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
            border-top: 5px solid transparent;
            background-image: linear-gradient(to bottom, var(--card-bg), rgba(100, 255, 218, 0.05));
        }
        
        .skill-card:hover {
            transform: translateY(-15px);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
            border-top: 5px solid var(--primary-color);
        }
        
        .skill-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, transparent, rgba(100, 255, 218, 0.05), transparent);
            transform: translateX(-100%);
            transition: transform 0.6s;
        }
        
        .skill-card:hover::before {
            transform: translateX(100%);
        }
        
        .skill-icon {
            font-size: 3.5rem;
            color: var(--primary-color);
            margin-bottom: 25px;
            transition: var(--transition);
        }
        
        .skill-card:hover .skill-icon {
            transform: scale(1.2);
        }
        
        .skill-card h3 {
            font-size: 2rem;
            margin-bottom: 20px;
            color: var(--text-light);
        }
        
        .skill-card p {
            color: var(--text-gray);
            font-size: 1.1rem;
            line-height: 1.7;
        }
        
        .projects {
            margin-bottom: 120px;
        }
        
        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 40px;
        }
        
        .project-card {
            background-color: var(--card-bg);
            border-radius: 15px;
            overflow: hidden;
            transition: var(--transition);
            position: relative;
        }
        
        .project-card:hover {
            transform: translateY(-15px);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
        }
        
        .project-img {
            height: 220px;
            background: linear-gradient(135deg, #0a192f, var(--card-bg));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 4.5rem;
            color: var(--primary-color);
            position: relative;
            overflow: hidden;
        }
        
        .project-img::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, rgba(100, 255, 218, 0.1), transparent);
        }
        
        .project-info {
            padding: 30px;
        }
        
        .project-info h3 {
            font-size: 1.8rem;
            margin-bottom: 15px;
            color: var(--text-light);
        }
        
        .project-info p {
            color: var(--text-gray);
            margin-bottom: 25px;
            font-size: 1.1rem;
            line-height: 1.7;
        }
        
        .project-tech {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }
        
        .tech-tag {
            background-color: rgba(100, 255, 218, 0.1);
            color: var(--primary-color);
            padding: 8px 18px;
            border-radius: 25px;
            font-size: 0.95rem;
            font-family: 'Roboto Mono', monospace;
            border: 1px solid rgba(100, 255, 218, 0.3);
            transition: var(--transition);
        }
        
        .tech-tag:hover {
            background-color: rgba(100, 255, 218, 0.2);
            transform: translateY(-3px);
        }
        
        .about {
            margin-bottom: 120px;
            background-color: var(--card-bg);
            border-radius: 20px;
            padding: 60px;
            position: relative;
            overflow: hidden;
        }
        
        .about::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(100, 255, 218, 0.1) 0%, transparent 70%);
        }
        
        .about h2 {
            font-size: 2.8rem;
            margin-bottom: 30px;
            color: var(--primary-color);
        }
        
        .about-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 40px;
        }
        
        .about-text {
            font-size: 1.2rem;
            color: var(--text-gray);
            line-height: 1.8;
        }
        
        .about-text p {
            margin-bottom: 25px;
        }
        
        .motivation-list {
            list-style-type: none;
        }
        
        .motivation-list li {
            margin-bottom: 20px;
            padding-left: 30px;
            position: relative;
            color: var(--text-gray);
            font-size: 1.1rem;
        }
        
        .motivation-list li::before {
            content: '▸';
            position: absolute;
            left: 0;
            color: var(--primary-color);
            font-size: 1.5rem;
        }
        
        .fun-element {
            text-align: center;
            margin: 80px 0;
            padding: 50px;
            background-color: var(--card-bg);
            border-radius: 20px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
        }
        
        .fun-element h3 {
            font-size: 2.5rem;
            margin-bottom: 20px;
            color: var(--primary-color);
        }
        
        .fun-element p {
            font-size: 1.3rem;
            color: var(--text-gray);
            margin-bottom: 30px;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }
        
        #clickMeBtn {
            margin: 20px 0;
            padding: 15px 40px;
            font-size: 1.3rem;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            border: none;
            color: var(--dark-bg);
            border-radius: 50px;
            cursor: pointer;
            transition: var(--transition);
            font-weight: 600;
            letter-spacing: 1px;
        }
        
        #clickMeBtn:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 15px 30px rgba(100, 255, 218, 0.3);
        }
        
        #clickCounter {
            font-size: 1.8rem;
            color: var(--primary-color);
            margin-top: 25px;
            font-family: 'Roboto Mono', monospace;
            font-weight: 500;
        }
        
        .contact {
            text-align: center;
            padding: 80px 0;
            background: linear-gradient(135deg, var(--card-bg), rgba(17, 34, 64, 0.9));
            border-radius: 25px;
            margin-bottom: 100px;
            position: relative;
            overflow: hidden;
        }
        
        .contact::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(circle at 20% 80%, rgba(100, 255, 218, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(0, 168, 255, 0.1) 0%, transparent 50%);
        }
        
        .contact h2 {
            font-size: 3.5rem;
            margin-bottom: 30px;
            color: var(--primary-color);
            position: relative;
            z-index: 1;
        }
        
        .contact p {
            font-size: 1.4rem;
            max-width: 800px;
            margin: 0 auto 50px;
            color: var(--text-gray);
            position: relative;
            z-index: 1;
            line-height: 1.8;
        }
        
        .contact .btn {
            position: relative;
            z-index: 1;
            padding: 18px 45px;
            font-size: 1.3rem;
            background: transparent;
            color: var(--primary-color);
            border: 2px solid var(--primary-color);
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
            display: inline-block;
            overflow: hidden;
        }
        
        .contact .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(100, 255, 218, 0.2), transparent);
            transition: left 0.7s;
        }
        
        .contact .btn:hover::before {
            left: 100%;
        }
        
        .contact .btn:hover {
            background-color: rgba(100, 255, 218, 0.1);
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(100, 255, 218, 0.2);
        }
        
        footer {
            text-align: center;
            padding: 50px 0;
            color: var(--text-gray);
            border-top: 1px solid rgba(100, 255, 218, 0.2);
            position: relative;
        }
        
        .social-links {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-bottom: 30px;
        }
        
        .social-links a {
            color: var(--text-light);
            font-size: 1.8rem;
            transition: var(--transition);
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background-color: var(--card-bg);
        }
        
        .social-links a:hover {
            color: var(--primary-color);
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
        }
        
        footer p {
            font-size: 1.1rem;
            margin-bottom: 10px;
        }
        
        .year {
            color: var(--primary-color);
            font-weight: 600;
        }
        
        @media (max-width: 1100px) {
            h1 {
                font-size: 3.5rem;
            }
            
            .section-title {
                font-size: 2.8rem;
            }
            
            .intro-text h2 {
                font-size: 2.5rem;
            }
        }
        
        @media (max-width: 768px) {
            h1 {
                font-size: 2.8rem;
            }
            
            .tagline {
                font-size: 1.5rem;
            }
            
            .intro {
                flex-direction: column;
                gap: 40px;
            }
            
            .section-title {
                font-size: 2.3rem;
            }
            
            .about {
                padding: 40px 30px;
            }
            
            .contact h2 {
                font-size: 2.8rem;
            }
            
            .contact p {
                font-size: 1.2rem;
            }
            
            .skill-card, .project-card {
                padding: 30px 20px;
            }
        }
        
        .scroll-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 50px;
            height: 50px;
            background-color: var(--primary-color);
            color: var(--dark-bg);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            cursor: pointer;
            transition: var(--transition);
            opacity: 0;
            visibility: hidden;
            z-index: 1000;
            box-shadow: 0 5px 20px rgba(100, 255, 218, 0.3);
        }
        
        .scroll-top.active {
            opacity: 1;
            visibility: visible;
        }
        
        .scroll-top:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(100, 255, 218, 0.4);
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <div class="header-bg"></div>
            <h1>Программирование - моя страсть</h1>
            <p class="tagline">Создание цифровых миров с помощью кода - это искусство, которым я живу</p>
        </header>
        
        <section class="intro">
            <div class="intro-text">
                <h2>Привет! Я Даниил</h2>
                <p>Программирование для меня - это не просто хобби или профессиональная деятельность. Это целая философия, способ мышления и инструмент для решения сложных задач. С самого первого знакомства с кодом я понял, что нашел свою стихию.</p>
                <p>Особенно меня вдохновляет работа с <span class="highlight">HTML</span> и <span class="highlight">JavaScript</span>. Эти технологии дают мгновенную визуальную обратную связь, что превращает процесс программирования в увлекательное творческое путешествие. Видеть, как твои идеи оживают в браузере - это невероятное ощущение.</p>
                <p>Веб-разработка сочетает в себе логику, дизайн и функциональность. Это область, где можно одновременно быть архитектором, художником и инженером. Каждый проект - это новая возможность создать что-то полезное, красивое и инновационное.</p>
                <p>Моя цель - не просто писать код, а создавать цифровые продукты, которые улучшают жизнь людей, решают реальные проблемы и приносят эстетическое удовольствие. Я верю, что хороший код должен быть не только функциональным, но и элегантным.</p>
            </div>
            
            <div class="code-display">
                <div class="code-header">
                    <div class="code-title">hobby.js</div>
                    <div class="code-icons">
                        <i class="fas fa-copy" title="Скопировать код"></i>
                        <i class="fas fa-play" title="Запустить код"></i>
                    </div>
                </div>
                <pre><code><span class="code-keyword">const</span> <span class="code-function">myCodingJourney</span> = {
  <span class="code-string">"название"</span>: <span class="code-string">"Путешествие в мир программирования"</span>,
  <span class="code-string">"старт"</span>: <span class="code-string">"2026 год"</span>,
  <span class="code-string">"специализация"</span>: [<span class="code-string">"Frontend разработка"</span>, <span class="code-string">"Веб-приложения"</span>],
  <span class="code-string">"технологии"</span>: [<span class="code-string">"HTML5"</span>, <span class="code-string">"JavaScript"</span>, <span class="code-string">"CSS3"</span>, <span class="code-string">"React"</span>],
  <span class="code-string">"уровень"</span>: <span class="code-string">"Продвинутый"</span>,
  
  <span class="code-function">описатьХобби</span>() {
    <span class="code-keyword">const</span> <span class="code-var">message</span> = <span class="code-string">`Мое программирование началось в ${this.старт}. `</span>;
    <span class="code-keyword">const</span> <span class="code-var">techMessage</span> = <span class="code-string">`Я обожаю создавать проекты с помощью ${this.технологии[0]} и ${this.технологии[1]}. `</span>;
    <span class="code-keyword">const</span> <span class="code-var">passionMessage</span> = <span class="code-string">"Каждая строчка кода для меня - это шаг к созданию чего-то удивительного!"</span>;
    
    <span class="code-keyword">return</span> <span class="code-var">message</span> + <span class="code-var">techMessage</span> + <span class="code-var">passionMessage</span>;
  },
  
  <span class="code-function">показатьСтатистику</span>() {
    <span class="code-keyword">const</span> <span class="code-var">projectsCount</span> = 24;
    <span class="code-keyword">const</span> <span class="code-var">linesOfCode</span> = 150000;
    <span class="code-keyword">const</span> <span class="code-var">hoursSpent</span> = 2800;
    
    <span class="code-keyword">return</span> {
      <span class="code-string">"проектов_завершено"</span>: <span class="code-var">projectsCount</span>,
      <span class="code-string">"строк_кода"</span>: <span class="code-var">linesOfCode</span>,
      <span class="code-string">"часов_потрачено"</span>: <span class="code-var">hoursSpent</span>
    };
  }
};

<span class="code-comment">// Использование объекта</span>
<span class="code-keyword">const</span> <span class="code-var">мойОпыт</span> = myCodingJourney.<span class="code-function">описатьХобби</span>();
<span class="code-keyword">const</span> <span class="code-var">мояСтатистика</span> = myCodingJourney.<span class="code-function">показатьСтатистику</span>();

console.<span class="code-function">log</span>(<span class="code-var">мойОпыт</span>);
console.<span class="code-function">table</span>(<span class="code-var">мояСтатистика</span>);</code></pre>
            </div>
        </section>
        
        <section class="skills">
            <h2 class="section-title">Мои ключевые навыки</h2>
            <div class="skills-grid">
                <div class="skill-card">
                    <div class="skill-icon">
                        <i class="fab fa-html5"></i>
