<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Чемпионат мира по хоккею</title>
</head>
<body>
    <h1 align="center">Чемпионат мира по хоккею</h1>
    
    <div align="center">
        <img src="data:image/jpeg;base64," 
             alt="Чемпионат мира по хоккею" 
             width="514" 
             height="432"
             border="1">
        
        <br>
        <font size="2" color="gray">
            Размеры изображения: 7.147 × 5.994 дюйма
        </font>
    </div>
    
    <br><br>
    
    <table align="center" border="1" cellpadding="10" cellspacing="0" width="90%" bgcolor="#f9f9f9">
        <tr bgcolor="#2c3e50">
            <th colspan="7">
                <font size="4" color="white">Турнирная таблица чемпионата мира</font>
            </th>
        </tr>
        <tr bgcolor="#3498db">
            <th width="10%"><font color="white">№</font></th>
            <th width="30%"><font color="white">Команда</font></th>
            <th width="10%"><font color="white">И</font></th>
            <th width="10%"><font color="white">В</font></th>
            <th width="10%"><font color="white">Н</font></th>
            <th width="10%"><font color="white">П</font></th>
            <th width="20%"><font color="white">Очки</font></th>
        </tr>
        <tr>
            <td align="center">1</td>
            <td><strong>Канада</strong></td>
            <td align="center">5</td>
            <td align="center">4</td>
            <td align="center">1</td>
            <td align="center">0</td>
            <td align="center" bgcolor="#e8f6f3"><strong>13</strong></td>
        </tr>
        <tr>
            <td align="center">2</td>
            <td><strong>Россия</strong></td>
            <td align="center">5</td>
            <td align="center">4</td>
            <td align="center">0</td>
            <td align="center">1</td>
            <td align="center" bgcolor="#e8f6f3"><strong>12</strong></td>
        </tr>
        <tr>
            <td align="center">3</td>
            <td><strong>Швеция</strong></td>
            <td align="center">5</td>
            <td align="center">3</td>
            <td align="center">1</td>
            <td align="center">1</td>
            <td align="center" bgcolor="#e8f6f3"><strong>10</strong></td>
        </tr>
        <tr>
            <td align="center">4</td>
            <td><strong>Финляндия</strong></td>
            <td align="center">5</td>
            <td align="center">3</td>
            <td align="center">0</td>
            <td align="center">2</td>
            <td align="center" bgcolor="#e8f6f3"><strong>9</strong></td>
        </tr>
        <tr>
            <td align="center">5</td>
            <td><strong>США</strong></td>
            <td align="center">5</td>
            <td align="center">2</td>
            <td align="center">0</td>
            <td align="center">3</td>
            <td align="center" bgcolor="#fef9e7"><strong>6</strong></td>
        </tr>
        <tr>
            <td align="center">6</td>
            <td><strong>Чехия</strong></td>
            <td align="center">5</td>
            <td align="center">1</td>
            <td align="center">0</td>
            <td align="center">4</td>
            <td align="center" bgcolor="#fdedec"><strong>3</strong></td>
        </tr>
    </table>
    
    <br><br>
    
    <table align="center" border="1" cellpadding="10" cellspacing="0" width="90%">
        <tr bgcolor="#27ae60">
            <th colspan="4">
                <font size="4" color="white">Статистика забитых шайб</font>
            </th>
        </tr>
        <tr bgcolor="#2ecc71">
            <th width="40%"><font color="white">Команда</font></th>
            <th width="20%"><font color="white">Забито</font></th>
            <th width="20%"><font color="white">Пропущено</font></th>
            <th width="20%"><font color="white">Разница</font></th>
        </tr>
        <tr>
            <td>Канада</td>
            <td align="center">28</td>
            <td align="center">10</td>
            <td align="center" bgcolor="#d5f4e6"><strong>+18</strong></td>
        </tr>
        <tr>
            <td>Россия</td>
            <td align="center">25</td>
            <td align="center">12</td>
            <td align="center" bgcolor="#d5f4e6"><strong>+13</strong></td>
        </tr>
        <tr>
            <td>Швеция</td>
            <td align="center">22</td>
            <td align="center">14</td>
            <td align="center" bgcolor="#d5f4e6"><strong>+8</strong></td>
        </tr>
        <tr>
            <td>Финляндия</td>
            <td align="center">19</td>
            <td align="center">16</td>
            <td align="center" bgcolor="#d5f4e6"><strong>+3</strong></td>
        </tr>
        <tr>
            <td>США</td>
            <td align="center">15</td>
            <td align="center">20</td>
            <td align="center" bgcolor="#fef9e7"><strong>-5</strong></td>
        </tr>
        <tr>
            <td>Чехия</td>
            <td align="center">12</td>
            <td align="center">29</td>
            <td align="center" bgcolor="#fdedec"><strong>-17</strong></td>
        </tr>
        <tr bgcolor="#34495e">
            <td align="right"><font color="white"><strong>Всего забито шайб:</strong></font></td>
            <td colspan="3" align="center">
                <font size="4" color="white"><strong>121 шайба</strong></font>
            </td>
        </tr>
    </table>
    
    <br><br>
    
    <table align="center" border="0" cellpadding="15" width="80%">
        <tr>
            <td bgcolor="#e8f4f8">
                <font size="2">
                    <strong>Легенда:</strong><br>
                    <strong>И</strong> - сыгранные матчи<br>
                    <strong>В</strong> - выигрыши (3 очка)<br>
                    <strong>Н</strong> - ничьи в основное время (2 очка)<br>
                    <strong>П</strong> - проигрыши (0 очков)<br>
                    <strong>Всего забито шайб:</strong> 28+25+22+19+15+12 = 121 шайба
                </font>
            </td>
        </tr>
    </table>
</body>
</html>
