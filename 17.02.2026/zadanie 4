<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Фотостудия «Шарм»</title>
    <style>
        body {
            background-color: #ffffcc; /* бледно-желтая заливка */
            font-family: Arial, sans-serif;
            margin: 30px;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            background-color: #ffffe6;
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 0 15px rgba(0,0,0,0.2);
        }
        h1 {
            text-align: center;
            color: red;
            font-weight: bold;
            font-size: 6em; /* размер шрифта 6 */
            margin: 20px 0;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }
        .logo {
            display: block;
            margin: 0 auto;
            width: 150px;
            height: 150px;
            background-color: #ffcccc;
            border-radius: 50%;
            text-align: center;
            line-height: 150px;
            font-size: 40px;
            color: #990000;
            border: 3px solid #990000;
        }
        .section {
            background-color: #fff5e6;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 10px;
            border-left: 5px solid #ff9999;
        }
        .section h2 {
            color: #cc3300;
            margin-top: 0;
            font-size: 1.3em;
        }
        .form-row {
            margin: 15px 0;
            display: flex;
            align-items: center;
        }
        .form-row label {
            width: 120px;
            font-weight: bold;
            color: #993300;
        }
        input[type="text"] {
            padding: 8px;
            border: 1px solid #ffb3b3;
            border-radius: 5px;
            font-family: inherit;
        }
        .checkbox-group, .radio-group {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            background-color: white;
            padding: 10px;
            border-radius: 5px;
        }
        .checkbox-group label, .radio-group label {
            font-weight: normal;
            width: auto;
        }
        select {
            padding: 8px;
            border: 1px solid #ffb3b3;
            border-radius: 5px;
            width: 200px;
            font-family: inherit;
        }
        .button-group {
            text-align: center;
            margin-top: 30px;
        }
        button {
            background-color: #ff6666;
            color: white;
            border: none;
            padding: 12px 40px;
            margin: 0 15px;
            border-radius: 25px;
            font-size: 1.1em;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
        }
        button:hover {
            background-color: #ff3333;
            transform: scale(1.05);
        }
        button.reset {
            background-color: #999999;
        }
        button.reset:hover {
            background-color: #777777;
        }
        .employee-link {
            margin-right: 15px;
            color: #0066cc;
            text-decoration: none;
            font-weight: bold;
        }
        .employee-link:hover {
            text-decoration: underline;
            color: #ff3300;
        }
        hr {
            border: 1px dashed #ff9999;
            margin: 30px 0;
        }
        .employee-card {
            background-color: #fff0e0;
            padding: 20px;
            border-radius: 15px;
            border: 2px solid #ffcccc;
            margin-top: 30px;
        }
        .employee-card h3 {
            color: #990000;
            text-align: center;
            margin-top: 0;
        }
        .employee-form {
            background-color: white;
            padding: 15px;
            border-radius: 10px;
        }
        .employee-form .form-row {
            margin: 10px 0;
        }
        .employee-form input[type="text"] {
            width: 200px;
        }
        .employee-form textarea {
            width: 100%;
            max-width: 400px;
            padding: 8px;
            border: 1px solid #ffb3b3;
            border-radius: 5px;
            font-family: inherit;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Логотип -->
        <div class="logo">
            📸
        </div>
        
        <!-- Заголовок -->
        <h1>Фотостудия «Шарм»</h1>

        <!-- Основная форма заказа -->
        <form>
            <div class="section">
                <h2>Контактные данные</h2>
                <div class="form-row">
                    <label>Имя заказчика:</label>
                    <input type="text" name="name" size="100" placeholder="Введите имя">
                </div>
                <div class="form-row">
                    <label>Адрес:</label>
                    <input type="text" name="address" size="150" placeholder="Введите адрес">
                </div>
                <div class="form-row">
                    <label>Телефон:</label>
                    <input type="text" name="phone" size="50" placeholder="Введите телефон">
                </div>
            </div>

            <div class="section">
                <h2>Тип фото</h2>
                <div class="checkbox-group">
                    <label><input type="checkbox" name="photo" value="color"> Цветное</label>
                    <label><input type="checkbox" name="photo" value="bw"> Черно-белое</label>
                    <label><input type="checkbox" name="photo" value="slide"> Цветной слайд</label>
                </div>
            </div>

            <div class="section">
                <h2>Срок исполнения</h2>
                <div class="radio-group">
                    <label><input type="radio" name="deadline" value="3"> 3 дня</label>
                    <label><input type="radio" name="deadline" value="10"> 10 дней</label>
                    <label><input type="radio" name="deadline" value="30"> 30 дней</label>
                </div>
            </div>

            <div class="section">
                <h2>Заказ принял</h2>
                <select name="employee">
                    <option value="ivanov">Иванов</option>
                    <option value="petrov">Петров</option>
                    <option value="sidorov">Сидоров</option>
                </select>
            </div>

            <div class="button-group">
                <button type="submit">Отправить</button>
                <button type="reset" class="reset">Очистить</button>
            </div>
        </form>

        <hr>

        <!-- Учетные карточки сотрудников -->
        <div class="employee-card">
            <h3>📋 Учетные карточки сотрудников</h3>
            
            <!-- Иванов -->
            <div class="employee-form" id="ivanov">
                <div style="text-align: center; margin-bottom: 15px;">
                    <a href="#ivanov" class="employee-link">Иванов</a>
                    <a href="#petrov" class="employee-link">Петров</a>
                    <a href="#sidorov" class="employee-link">Сидоров</a>
                </div>
                <form>
                    <div class="form-row">
                        <label>Фамилия сотрудника:</label>
                        <input type="text" name="lastname" value="Иванов" readonly>
                    </div>
                    <div class="form-row">
                        <label>Владение языками:</label>
                        <div class="checkbox-group">
                            <label><input type="checkbox" name="lang" value="en"> Английский</label>
                            <label><input type="checkbox" name="lang" value="de"> Немецкий</label>
                            <label><input type="checkbox" name="lang" value="es"> Испанский</label>
                        </div>
                    </div>
                    <div class="form-row">
                        <label>Пол:</label>
                        <div class="radio-group">
                            <label><input type="radio" name="gender" value="m"> М</label>
                            <label><input type="radio" name="gender" value="f"> Ж</label>
                        </div>
                    </div>
                    <div class="form-row">
                        <label>Дополнительно:</label>
                        <textarea rows="3" placeholder="Введите дополнительные сведения"></textarea>
                    </div>
                </form>
            </div>

            <!-- Петров -->
            <div class="employee-form" id="petrov" style="margin-top: 20px;">
                <form>
                    <div class="form-row">
                        <label>Фамилия сотрудника:</label>
                        <input type="text" name="lastname" value="Петров" readonly>
                    </div>
                    <div class="form-row">
                        <label>Владение языками:</label>
                        <div class="checkbox-group">
                            <label><input type="checkbox" name="lang" value="en"> Английский</label>
                            <label><input type="checkbox" name="lang" value="de"> Немецкий</label>
                            <label><input type="checkbox" name="lang" value="es"> Испанский</label>
                        </div>
                    </div>
                    <div class="form-row">
                        <label>Пол:</label>
                        <div class="radio-group">
                            <label><input type="radio" name="gender" value="m"> М</label>
                            <label><input type="radio" name="gender" value="f"> Ж</label>
                        </div>
                    </div>
                    <div class="form-row">
                        <label>Дополнительно:</label>
                        <textarea rows="3" placeholder="Введите дополнительные сведения"></textarea>
                    </div>
                </form>
            </div>

            <!-- Сидоров -->
            <div class="employee-form" id="sidorov" style="margin-top: 20px;">
                <form>
                    <div class="form-row">
                        <label>Фамилия сотрудника:</label>
                        <input type="text" name="lastname" value="Сидоров" readonly>
                    </div>
                    <div class="form-row">
                        <label>Владение языками:</label>
                        <div class="checkbox-group">
                            <label><input type="checkbox" name="lang" value="en"> Английский</label>
                            <label><input type="checkbox" name="lang" value="de"> Немецкий</label>
                            <label><input type="checkbox" name="lang" value="es"> Испанский</label>
                        </div>
                    </div>
                    <div class="form-row">
                        <label>Пол:</label>
                        <div class="radio-group">
                            <label><input type="radio" name="gender" value="m"> М</label>
                            <label><input type="radio" name="gender" value="f"> Ж</label>
                        </div>
                    </div>
                    <div class="form-row">
                        <label>Дополнительно:</label>
                        <textarea rows="3" placeholder="Введите дополнительные сведения"></textarea>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
