<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Калькулятор</title>
    <style>
        body {
            background-color: #f0f0f0;
            font-family: Arial, sans-serif;
            padding: 20px;
        }
        .calculator {
            background-color: #e0e0e0;
            border: 2px solid #333;
            border-radius: 10px;
            width: 400px;
            padding: 20px;
            margin: 0 auto;
            box-shadow: 5px 5px 10px rgba(0,0,0,0.2);
        }
        h1 {
            text-align: center;
            margin-top: 0;
            color: #333;
        }
        .input-group {
            margin: 10px 0;
        }
        .input-group label {
            display: inline-block;
            width: 100px;
            font-weight: bold;
        }
        .input-group input {
            width: 250px;
            padding: 5px;
            border: 1px solid #999;
            border-radius: 3px;
        }
        .result {
            background-color: #fff;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #999;
            border-radius: 3px;
            font-weight: bold;
        }
        .buttons {
            margin: 20px 0;
            text-align: center;
        }
        .buttons button {
            width: 60px;
            height: 40px;
            margin: 0 5px;
            font-size: 18px;
            font-weight: bold;
            background-color: #4CAF50;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        .buttons button:hover {
            background-color: #45a049;
        }
        .clear-btn {
            text-align: center;
            margin-top: 20px;
        }
        .clear-btn button {
            padding: 10px 30px;
            font-size: 16px;
            background-color: #f44336;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        .clear-btn button:hover {
            background-color: #da190b;
        }
        .note {
            text-align: center;
            margin-top: 10px;
            color: #666;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="calculator">
        <h1>Калькулятор</h1>
        
        <div class="input-group">
            <label>Первое число</label>
            <input type="number" id="num1" value="0">
        </div>
        
        <div class="input-group">
            <label>Второе число</label>
            <input type="number" id="num2" value="0">
        </div>
        
        <div class="result">
            Результат: <span id="result">0</span>
        </div>
        
        <div class="buttons">
            <button onclick="calculate('+')">+</button>
            <button onclick="calculate('-')">-</button>
            <button onclick="calculate('*')">*</button>
            <button onclick="calculate('/')">/</button>
        </div>
        
        <div class="clear-btn">
            <button onclick="clearAll()">Очистить</button>
        </div>
        
        <div class="note">
            Введите числа и нажмите нужную операцию
        </div>
    </div>

    <script>
        function calculate(operation) {
            let num1 = parseFloat(document.getElementById('num1').value) || 0;
            let num2 = parseFloat(document.getElementById('num2').value) || 0;
            let result = 0;
            
            switch(operation) {
                case '+':
                    result = num1 + num2;
                    break;
                case '-':
                    result = num1 - num2;
                    break;
                case '*':
                    result = num1 * num2;
                    break;
                case '/':
                    if(num2 === 0) {
                        alert('На ноль делить нельзя!');
                        return;
                    }
                    result = num1 / num2;
                    break;
            }
            
            document.getElementById('result').textContent = result;
        }
        
        function clearAll() {
            document.getElementById('num1').value = '0';
            document.getElementById('num2').value = '0';
            document.getElementById('result').textContent = '0';
        }
    </script>
</body>
</html>
