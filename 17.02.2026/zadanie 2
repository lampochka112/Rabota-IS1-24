<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Бланк</title>
    <style>
        body {
            background-color:  lightgreen;
            font-family: Arial, sans-serif;
            padding: 20px;
        }
        .product-item {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 5px;
        }
        .product-item img {
            width: 50px;
            height: 50px;
            object-fit: cover;
        }
        .radio-group {
            margin: 10px 0;
        }
        .radio-group label {
            margin-right: 15px;
        }
    </style>
</head>
<body>

    <h1>Бланк</h1>

    - Фамилия<br>
    - Адрес<br>
    <br>

    <h2>Наши товары</h2>
    <div class="product-item">
        <input type="checkbox">
        <img src="data:image/jpeg;base64," alt="товар 1">
    </div>
    <div class="product-item">
        <input type="checkbox">
        <img src="data:image/jpeg;base64," alt="товар 2">
    </div>
    <div class="product-item">
        <input type="checkbox">
        <img src="data:image/jpeg;base64," alt="товар 3">
    </div>
    <br>

    <h2>Сумма, которой вы располагаете</h2>
    <div class="radio-group">
        <label><input type="radio" name="amount" value="100"> $100</label>
        <label><input type="radio" name="amount" value="500"> $500</label>
        <label><input type="radio" name="amount" value="1000"> $1000</label>
    </div>
    <br>
    <button>Отправить</button> &nbsp; <button>Сброс</button>

</body>
</html>
